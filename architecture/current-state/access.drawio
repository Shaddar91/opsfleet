        <mxCell id="gate_b" value="deploy_enabled is off (ci/github-actions) and becomes the variable DEPLOY_ENABLED. The workflow Terraform commits pushes on every master push and never reads it; only an uncommitted local edit of the workflow does." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;align=left;spacingLeft=8;spacingTop=3;fontSize=11;" vertex="1" parent="acct">
