        <mxCell id="pods" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;of-api pods&lt;/font&gt;&lt;/b&gt;, namespace of&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#687078&quot;&gt;of-helm: charts/of-api&lt;/font&gt;&lt;br&gt;Service account without annotations. SecretProviderClass &amp;lt;fullname&amp;gt;-db: provider aws, usePodIdentity on, object db.secretArn (CHANGEME)." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;align=left;spacingLeft=8;spacingTop=3;fontSize=11;" vertex="1" parent="acct">
