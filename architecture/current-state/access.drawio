        <mxCell id="role_a" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;opsfleet-terraform-plan-role&lt;/font&gt;&lt;/b&gt;: ReadOnlyAccess. Trust: sub repo:&amp;lt;github-owner&amp;gt;@&amp;lt;owner-id&amp;gt;/opsfleet@&amp;lt;repo-id&amp;gt;:ref:refs/heads/&amp;lt;default-branch&amp;gt;.&lt;br&gt;&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;opsfleet-terraform-apply-role&lt;/font&gt;&lt;/b&gt;: AdministratorAccess. Trust: the same sub prefix ending :environment:terraform.&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#687078&quot;&gt;system/iam/terraform-ci&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;align=left;spacingLeft=46;spacingTop=3;fontSize=11;" vertex="1" parent="acct">
          <mxGeometry x="200" y="962" width="680" height="112" as="geometry" />
