          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1_6" value="" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeWidth=2.5;strokeColor=#DD344C;fontSize=11;fontColor=#545B64;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.1486;exitDx=0;exitDy=0;entryX=0.0;entryY=0.1486;entryDx=0;entryDy=0;" edge="1" parent="1" source="d6" target="d7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1_7" value="" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeWidth=2.5;strokeColor=#DD344C;fontSize=11;fontColor=#545B64;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.1486;exitDx=0;exitDy=0;entryX=0.0;entryY=0.1486;entryDx=0;entryDy=0;" edge="1" parent="1" source="d7" target="d8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1_8" value="" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeWidth=2.5;strokeColor=#DD344C;fontSize=11;fontColor=#545B64;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.1486;exitDx=0;exitDy=0;entryX=0.0;entryY=0.1486;entryDx=0;entryDy=0;" edge="1" parent="1" source="d8" target="d9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1_9" value="" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeWidth=2.5;strokeColor=#DD344C;fontSize=11;fontColor=#545B64;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.1486;exitDx=0;exitDy=0;entryX=0.0;entryY=0.1486;entryDx=0;entryDy=0;" edge="1" parent="1" source="d9" target="d10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1_bypass" value="today: STS asks for no MFA code" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeWidth=2.5;strokeColor=#DD344C;fontSize=11;fontColor=#545B64;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=1.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d4" target="d6">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1458" y="424" />
              <mxPoint x="2038" y="424" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="perm" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Group rights: IAM group prod01-us-developers&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#687078&quot;&gt;system/access/developers&lt;/font&gt;&lt;br&gt;ReadOnlyAccess (AWS managed policy), plus group.json:&lt;br&gt;Deny s3:* on &amp;lt;state-bucket&amp;gt; and its objects&lt;br&gt;Deny s3:* on S3 access point paths&lt;br&gt;Deny secretsmanager:GetSecretValue and BatchGetSecretValue&lt;br&gt;Deny kms:Decrypt through SSM or Secrets Manager&lt;br&gt;Allow sts:AssumeRole on the deploy role only" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;align=left;spacingLeft=50;spacingTop=3;fontSize=11;" vertex="1" parent="acct">
          <mxGeometry x="40" y="342" width="546" height="150" as="geometry" />
        </mxCell>
        <mxCell id="perm_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.permissions;dashed=0;" vertex="1" parent="perm">
          <mxGeometry x="8" y="8" width="34" height="34" as="geometry" />
        </mxCell>
        <mxCell id="e1_perm" value="group policy" style="html=1;rounded=0;endArrow=none;strokeWidth=1.2;strokeColor=#879196;fontSize=10;fontColor=#545B64;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.2344;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="perm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mfa_plan" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Designed, not built yet&lt;/font&gt;&lt;/b&gt;&lt;br&gt;The deploy role trust policy gets the condition aws:MultiFactorAuthPresent; each user registers an MFA device and passes --serial-number and --token-code (the dashed lines in step 3). STS then refuses a call without a valid code." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#F7F7F7;strokeColor=#545B64;dashed=1;dashPattern=6 4;strokeWidth=1.5;align=left;spacingLeft=8;spacingTop=3;fontSize=11;" vertex="1" parent="acct">
          <mxGeometry x="910" y="342" width="836" height="80" as="geometry" />
        </mxCell>
        <mxCell id="kreach" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Where kubectl can connect&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#687078&quot;&gt;prod01-us-east-1/cluster/eks, prod01-us-east-1/network&lt;/font&gt;&lt;br&gt;The public API endpoint accepts only the /32 of the machine that ran Terraform, read at plan time; the private endpoint answers inside the VPC. The bastion has kubectl and helm but opens only through SSM Session Manager, and ReadOnlyAccess grants no ssm:StartSession." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;align=left;spacingLeft=8;spacingTop=3;fontSize=11;" vertex="1" parent="acct">
          <mxGeometry x="2070" y="342" width="836" height="84" as="geometry" />
        </mxCell>
        <mxCell id="o0" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Operator workstation&lt;/font&gt;&lt;/b&gt;&lt;br&gt;AWS CLI, Terraform and tfctl.sh. A site env file outside the repository sets AWS_CONFIG_FILE, AWS_PROFILE, STATE_BUCKET, STATE_BUCKET_REGION and STATE_KEY_PREFIX." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;spacingLeft=6;spacingTop=62;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="90" y="650" width="256" height="180" as="geometry" />
        </mxCell>
        <mxCell id="o0_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.client;dashed=0;" vertex="1" parent="o0">
          <mxGeometry x="103" y="8" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="o1" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;IAM user of the source profile&lt;/font&gt;&lt;/b&gt;&lt;br&gt;In this account; created outside this repository." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#545B64;dashed=1;dashPattern=1 2;strokeWidth=2;spacingLeft=6;spacingTop=62;align=center;fontSize=11;" vertex="1" parent="acct">
          <mxGeometry x="40" y="546" width="256" height="206" as="geometry" />
        </mxCell>
        <mxCell id="o1_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.user;dashed=0;" vertex="1" parent="o1">
          <mxGeometry x="103" y="8" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="o2" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Source profile access key&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Long-lived key in the AWS credentials file. The profile names role_arn and source_profile, and no mfa_serial." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#545B64;dashed=1;dashPattern=1 2;strokeWidth=2;spacingLeft=6;spacingTop=62;align=center;fontSize=11;" vertex="1" parent="acct">
          <mxGeometry x="330" y="546" width="256" height="206" as="geometry" />
        </mxCell>
        <mxCell id="o2_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.long_term_security_credential;dashed=0;" vertex="1" parent="o2">
          <mxGeometry x="103" y="8" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="o3" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;AWS STS: sts:AssumeRole&lt;/font&gt;&lt;/b&gt;&lt;br&gt;The AWS CLI and the Terraform provider assume the role with the source keys. No MFA: the profile has no mfa_serial." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;spacingLeft=6;spacingTop=62;align=center;fontSize=11;" vertex="1" parent="acct">
          <mxGeometry x="620" y="546" width="256" height="206" as="geometry" />
        </mxCell>
        <mxCell id="o3_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sts;" vertex="1" parent="o3">
          <mxGeometry x="103" y="8" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="o4" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Temporary credentials&lt;/font&gt;&lt;/b&gt;&lt;br&gt;A session of &amp;lt;terraform-role&amp;gt;; aws sts get-caller-identity reports an assumed role." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;spacingLeft=6;spacingTop=62;align=center;fontSize=11;" vertex="1" parent="acct">
          <mxGeometry x="910" y="546" width="256" height="206" as="geometry" />
        </mxCell>
        <mxCell id="o4_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.temporary_security_credential;dashed=0;" vertex="1" parent="o4">
          <mxGeometry x="103" y="8" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="o5" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;&amp;lt;terraform-role&amp;gt;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Created outside this repository: no file under terraform/ names it." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#545B64;dashed=1;dashPattern=1 2;strokeWidth=2;spacingLeft=6;spacingTop=62;align=center;fontSize=11;" vertex="1" parent="acct">
          <mxGeometry x="1200" y="546" width="256" height="206" as="geometry" />
        </mxCell>
        <mxCell id="o5_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.role;dashed=0;" vertex="1" parent="o5">
          <mxGeometry x="103" y="8" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="o6" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Run Terraform&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;spacingLeft=6;spacingTop=6;align=center;fontSize=11;" vertex="1" parent="acct">
          <mxGeometry x="1490" y="546" width="256" height="206" as="geometry" />
        </mxCell>
        <mxCell id="o6_c" value="./tfctl.sh &amp;lt;tier&amp;gt; plan &amp;lt;stack&amp;gt;&lt;br&gt;./tfctl.sh &amp;lt;tier&amp;gt; apply &amp;lt;stack&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=11;fontColor=#232F3E;spacingLeft=5;spacingTop=1;fillColor=#F4F6F8;strokeColor=#D5DBDB;" vertex="1" parent="o6">
          <mxGeometry x="8" y="32" width="240" height="38" as="geometry" />
        </mxCell>
        <mxCell id="o6_t" value="Also validate, output, destroy, status, roll, unroll, check, order and help. Sources the env file when STATE_BUCKET is unset; each stack's init.sh renders provider.auto.tf and runs terraform init." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;verticalAlign=top;align=center;" vertex="1" parent="o6">
          <mxGeometry x="6" y="76" width="244" height="130" as="geometry" />
        </mxCell>
        <mxCell id="o7" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Terraform state &amp;lt;state-bucket&amp;gt;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#687078&quot;&gt;system/s3/state-bucket&lt;/font&gt;&lt;br&gt;eu-central-1; one encrypted key per stack under &amp;lt;prefix&amp;gt;/. The stack creates the bucket, or reads an existing one when create_state_bucket is off. Then the AWS APIs of every stack." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;spacingLeft=6;spacingTop=62;align=center;fontSize=11;" vertex="1" parent="acct">
          <mxGeometry x="1780" y="546" width="256" height="206" as="geometry" />
        </mxCell>
        <mxCell id="o7_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="o7">
          <mxGeometry x="103" y="8" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="o8" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;EKS access entry admin&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#687078&quot;&gt;cluster/eks in each region&lt;/font&gt;&lt;br&gt;The principal that runs Terraform, read from the session by aws_iam_session_context: AmazonEKSClusterAdminPolicy, cluster scope, on prod01-us-eks and prod01-usw2-eks. The public endpoint opens to that machine's IP (/32)." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;spacingLeft=6;spacingTop=62;align=center;fontSize=11;" vertex="1" parent="acct">
          <mxGeometry x="2070" y="546" width="256" height="206" as="geometry" />
        </mxCell>
        <mxCell id="o8_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eks;" vertex="1" parent="o8">
          <mxGeometry x="103" y="8" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="o9" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Cluster admin commands&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;spacingLeft=6;spacingTop=6;align=center;fontSize=11;" vertex="1" parent="acct">
          <mxGeometry x="2360" y="546" width="256" height="206" as="geometry" />
        </mxCell>
        <mxCell id="o9_c" value="aws eks update-kubeconfig&lt;br&gt;&amp;nbsp;--region us-east-1&lt;br&gt;&amp;nbsp;--name prod01-us-eks" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=11;fontColor=#232F3E;spacingLeft=5;spacingTop=1;fillColor=#F4F6F8;strokeColor=#D5DBDB;" vertex="1" parent="o9">
          <mxGeometry x="8" y="32" width="240" height="52" as="geometry" />
        </mxCell>
        <mxCell id="o9_t" value="Then kubectl and helm with cluster admin rights." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;verticalAlign=top;align=center;" vertex="1" parent="o9">
          <mxGeometry x="6" y="90" width="244" height="60" as="geometry" />
        </mxCell>
