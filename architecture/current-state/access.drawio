        </mxCell>
        <mxCell id="act_b" value="Push &amp;lt;sha&amp;gt;-amd64 and &amp;lt;sha&amp;gt;-arm64, then the multi-arch index &amp;lt;sha&amp;gt;, to ECR of-api (tags immutable, scan on push).&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#687078&quot;&gt;system/ecr/of-api&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;align=left;spacingLeft=46;spacingTop=3;fontSize=11;" vertex="1" parent="acct">
