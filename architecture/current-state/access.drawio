<mxfile host="app.diagrams.net">
  <diagram id="current-access" name="Current state: access">
    <mxGraphModel dx="3400" dy="2300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3400" pageHeight="2300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Current state: sign-in, MFA, STS assume role and commands in the one AWS account" style="text;html=1;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="2600" height="42" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Drawn from the Terraform code and the workflows it deploys; it makes no claim about what is deployed today." style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#545B64;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="2600" height="24" as="geometry" />
        </mxCell>
        <mxCell id="subtitle2" value="Each lane starts outside AWS on the left and ends at the rights a principal gets. Angle brackets mark a site value kept out of this repository; small grey text names the Terraform stack (path under terraform/)." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#687078;" vertex="1" parent="1">
          <mxGeometry x="40" y="76" width="2600" height="20" as="geometry" />
        </mxCell>
        <mxCell id="outside" value="Outside AWS" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#545B64;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="300" height="22" as="geometry" />
        </mxCell>
        <mxCell id="acct" value="AWS account (standalone, no AWS Organization)" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=15;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;strokeColor=#CD2264;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#CD2264;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="420" y="104" width="2960" height="1922" as="geometry" />
        </mxCell>
        <mxCell id="l1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFBFB;strokeColor=#D5DBDB;" vertex="1" parent="acct">
          <mxGeometry x="20" y="36" width="2920" height="450" as="geometry" />
        </mxCell>
        <mxCell id="l1_t" value="1 Developer: IAM user, MFA, sts:AssumeRole, kubectl in namespace of" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#DD344C;" vertex="1" parent="acct">
          <mxGeometry x="32" y="42" width="2200" height="28" as="geometry" />
        </mxCell>
        <mxCell id="l2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFBFB;strokeColor=#D5DBDB;" vertex="1" parent="acct">
          <mxGeometry x="20" y="502" width="2920" height="316" as="geometry" />
        </mxCell>
        <mxCell id="l2_t" value="2 Operator: source profile, sts:AssumeRole, tfctl.sh, cluster admin" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#147EBA;" vertex="1" parent="acct">
          <mxGeometry x="32" y="508" width="2200" height="28" as="geometry" />
        </mxCell>
        <mxCell id="l3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFBFB;strokeColor=#D5DBDB;" vertex="1" parent="acct">
          <mxGeometry x="20" y="834" width="2920" height="762" as="geometry" />
        </mxCell>
        <mxCell id="l3_t" value="3 CI: GitHub Actions, OIDC token, sts:AssumeRoleWithWebIdentity, one role per pipeline" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#ED7100;" vertex="1" parent="acct">
          <mxGeometry x="32" y="840" width="2200" height="28" as="geometry" />
        </mxCell>
        <mxCell id="l4" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFBFB;strokeColor=#D5DBDB;" vertex="1" parent="acct">
          <mxGeometry x="20" y="1612" width="2920" height="294" as="geometry" />
        </mxCell>
        <mxCell id="l4_t" value="4 In cluster: Argo CD and pods" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#8C4FFF;" vertex="1" parent="acct">
          <mxGeometry x="32" y="1618" width="2200" height="28" as="geometry" />
        </mxCell>
        <mxCell id="d0" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Developer laptop&lt;/font&gt;&lt;/b&gt;&lt;br&gt;AWS CLI and kubectl, signed with the developer's own IAM user credentials." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;spacingLeft=6;spacingTop=62;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="90" y="184" width="256" height="140" as="geometry" />
        </mxCell>
        <mxCell id="d0_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.client;dashed=0;" vertex="1" parent="d0">
          <mxGeometry x="103" y="8" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;IAM user &amp;lt;developer&amp;gt;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Member of IAM group prod01-us-developers (system/access/developers). The owner creates the user outside this repository and adds it to the group; membership is the only per-person step." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#545B64;dashed=1;dashPattern=1 2;strokeWidth=2;spacingLeft=6;spacingTop=62;align=center;fontSize=11;" vertex="1" parent="acct">
          <mxGeometry x="40" y="80" width="256" height="222" as="geometry" />
        </mxCell>
        <mxCell id="d1_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.user;dashed=0;" vertex="1" parent="d1">
          <mxGeometry x="103" y="8" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Access key (CLI) or password (console)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Long-lived; created with the user, outside this repository. Everything done with them runs with the group rights below." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#545B64;dashed=1;dashPattern=1 2;strokeWidth=2;spacingLeft=6;spacingTop=62;align=center;fontSize=11;" vertex="1" parent="acct">
          <mxGeometry x="330" y="80" width="256" height="222" as="geometry" />
        </mxCell>
        <mxCell id="d2_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.long_term_security_credential;dashed=0;" vertex="1" parent="d2">
          <mxGeometry x="103" y="8" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Assume the deploy role&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;spacingLeft=6;spacingTop=6;align=center;fontSize=11;" vertex="1" parent="acct">
          <mxGeometry x="620" y="80" width="256" height="222" as="geometry" />
        </mxCell>
        <mxCell id="d3_c" value="aws sts assume-role&lt;br&gt;&amp;nbsp;--role-arn &amp;lt;deploy-role-arn&amp;gt;&lt;br&gt;&amp;nbsp;--role-session-name &amp;lt;name&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=11;fontColor=#232F3E;spacingLeft=5;spacingTop=1;fillColor=#F4F6F8;strokeColor=#D5DBDB;" vertex="1" parent="d3">
          <mxGeometry x="8" y="32" width="240" height="52" as="geometry" />
        </mxCell>
        <mxCell id="d3_m" value="&amp;nbsp;--serial-number &amp;lt;mfa-device-arn&amp;gt;&lt;br&gt;&amp;nbsp;--token-code &amp;lt;code&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=11;fontColor=#232F3E;spacingLeft=5;spacingTop=1;fillColor=#FFFFFF;strokeColor=#545B64;dashed=1;dashPattern=6 4;strokeWidth=1.5;" vertex="1" parent="d3">
          <mxGeometry x="8" y="88" width="240" height="38" as="geometry" />
        </mxCell>
        <mxCell id="d3_t" value="The dashed lines are the MFA step of the access design; today the call succeeds without them." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;verticalAlign=top;align=center;" vertex="1" parent="d3">
          <mxGeometry x="6" y="132" width="244" height="64" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;AWS STS: sts:AssumeRole&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Both sides must allow the call: group.json allows sts:AssumeRole on the deploy role, and the role trusts the account root with no condition." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;spacingLeft=6;spacingTop=62;align=center;fontSize=11;" vertex="1" parent="acct">
          <mxGeometry x="910" y="80" width="256" height="222" as="geometry" />
        </mxCell>
        <mxCell id="d4_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sts;" vertex="1" parent="d4">
          <mxGeometry x="103" y="8" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d5" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;MFA: designed, not yet a condition in the deploy role trust policy&lt;/font&gt;&lt;/b&gt;&lt;br&gt;No MFA device, aws:MultiFactorAuthPresent condition or token code exists in any Terraform file, policy, script or workflow, so STS asks for no code." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#F7F7F7;strokeColor=#545B64;dashed=1;dashPattern=6 4;strokeWidth=1.5;spacingLeft=6;spacingTop=62;align=center;fontSize=11;" vertex="1" parent="acct">
          <mxGeometry x="1200" y="80" width="256" height="222" as="geometry" />
        </mxCell>
        <mxCell id="d5_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.mfa_token;dashed=1;" vertex="1" parent="d5">
          <mxGeometry x="103" y="8" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d6" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Temporary credentials&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Access key id, secret key and session token of the deploy role. One hour: the role sets no maximum session duration, so the IAM default applies." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;spacingLeft=6;spacingTop=62;align=center;fontSize=11;" vertex="1" parent="acct">
          <mxGeometry x="1490" y="80" width="256" height="222" as="geometry" />
        </mxCell>
        <mxCell id="d6_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.temporary_security_credential;dashed=0;" vertex="1" parent="d6">
          <mxGeometry x="103" y="8" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d7" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;prod01-us-developers-deploy-role&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#687078&quot;&gt;system/access/developers&lt;/font&gt;&lt;br&gt;Policy: eks:DescribeCluster on prod01-us-eks, nothing else. Its Kubernetes rights come from the access entry in step 9." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;spacingLeft=6;spacingTop=62;align=center;fontSize=11;" vertex="1" parent="acct">
          <mxGeometry x="1780" y="80" width="256" height="222" as="geometry" />
        </mxCell>
        <mxCell id="d7_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.role;dashed=0;" vertex="1" parent="d7">
          <mxGeometry x="103" y="8" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d8" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Point kubectl at the cluster&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;spacingLeft=6;spacingTop=6;align=center;fontSize=11;" vertex="1" parent="acct">
          <mxGeometry x="2070" y="80" width="256" height="222" as="geometry" />
        </mxCell>
        <mxCell id="d8_c" value="aws eks update-kubeconfig&lt;br&gt;&amp;nbsp;--region us-east-1&lt;br&gt;&amp;nbsp;--name prod01-us-eks&lt;br&gt;&amp;nbsp;--role-arn &amp;lt;deploy-role-arn&amp;gt;&lt;br&gt;kubectl config set-context&lt;br&gt;&amp;nbsp;--current --namespace of" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=11;fontColor=#232F3E;spacingLeft=5;spacingTop=1;fillColor=#F4F6F8;strokeColor=#D5DBDB;" vertex="1" parent="d8">
          <mxGeometry x="8" y="32" width="240" height="96" as="geometry" />
        </mxCell>
        <mxCell id="d8_t" value="The stack output kubeconfig_command, run once with the user's own keys. Afterwards each kubectl call runs aws eks get-token, which assumes the deploy role." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;verticalAlign=top;align=center;" vertex="1" parent="d8">
          <mxGeometry x="6" y="134" width="244" height="84" as="geometry" />
        </mxCell>
        <mxCell id="d9" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;EKS prod01-us-eks: access entry&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#687078&quot;&gt;system/access/developers&lt;/font&gt;&lt;br&gt;STANDARD entry for the deploy role: AmazonEKSEditPolicy in namespace of only. The stack refuses any kube-* namespace." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;spacingLeft=6;spacingTop=62;align=center;fontSize=11;" vertex="1" parent="acct">
          <mxGeometry x="2360" y="80" width="256" height="222" as="geometry" />
        </mxCell>
        <mxCell id="d9_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eks;" vertex="1" parent="d9">
          <mxGeometry x="103" y="8" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d10" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Commands in namespace of&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;spacingLeft=6;spacingTop=6;align=center;fontSize=11;" vertex="1" parent="acct">
          <mxGeometry x="2650" y="80" width="256" height="222" as="geometry" />
        </mxCell>
        <mxCell id="d10_c" value="kubectl get pods&lt;br&gt;kubectl apply -f &amp;lt;manifest&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=11;fontColor=#232F3E;spacingLeft=5;spacingTop=1;fillColor=#F4F6F8;strokeColor=#D5DBDB;" vertex="1" parent="d10">
          <mxGeometry x="8" y="32" width="240" height="38" as="geometry" />
        </mxCell>
        <mxCell id="d10_t" value="Kubernetes edit rights in namespace of, nothing outside it. AWS calls signed with the user's own keys stay read only, minus the denies." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;verticalAlign=top;align=center;" vertex="1" parent="d10">
          <mxGeometry x="6" y="76" width="244" height="110" as="geometry" />
        </mxCell>
        <mxCell id="b1_0" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#DD344C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="acct">
          <mxGeometry x="46" y="86" width="26" height="26" as="geometry" />
