          <mxGeometry x="8" y="8" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="e_disp" value="dispatches terraform.yml" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeWidth=2.5;strokeColor=#147EBA;fontSize=11;fontColor=#545B64;labelBackgroundColor=#FFFFFF;exitX=0.6445;exitY=1.0;exitDx=0;exitDy=0;entryX=0.911;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="o0" target="wf_a">
