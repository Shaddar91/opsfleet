        <mxCell id="sm_i_w" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;" vertex="1" parent="sm_w">
          <mxGeometry x="8" y="8" width="34" height="34" as="geometry" />
        </mxCell>
        <mxCell id="ecr_w" value="&lt;b&gt;ECR us-west-2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#687078&quot;&gt;system/ecr&lt;/font&gt;&lt;br&gt;of-api-usw2 and of-load-usw2: copies of the us-east-1 repositories, filled by replication; the nodes here pull from them.&lt;br&gt;of-failover: the failover function image, pushed by its CI.&lt;br&gt;Nodes pull through the NAT gateway; image layers come from S3 through the gateway endpoint." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingRight=6;spacingTop=4;spacingLeft=50;container=1;collapsible=0;" vertex="1" parent="reg_w">
