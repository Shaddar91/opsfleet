        <mxCell id="pub2" value="Public subnet 10.144.196.0/22" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F6E8;strokeColor=#7AA116;fontColor=#248814;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;container=1;collapsible=0;" vertex="1" parent="az2">
          <mxGeometry x="8" y="27" width="444" height="508" as="geometry" />
        </mxCell>
        <mxCell id="bas2" value="Bastion subnet 10.144.204.16/28" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F6E8;strokeColor=#7AA116;fontColor=#248814;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;container=1;collapsible=0;" vertex="1" parent="az2">
          <mxGeometry x="8" y="543" width="444" height="92" as="geometry" />
        </mxCell>
        <mxCell id="prv2" value="Private subnet 10.144.64.0/18" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6F6F7;strokeColor=#00A4A6;fontColor=#147EBA;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;container=1;collapsible=0;" vertex="1" parent="az2">
