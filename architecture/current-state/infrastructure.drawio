        </mxCell>
        <mxCell id="nonat3_w" value="No NAT gateway in this zone" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=9;fontColor=#545B64;" vertex="1" parent="pub3_w">
          <mxGeometry x="82" y="480" width="140" height="18" as="geometry" />
        </mxCell>
        <mxCell id="bas3_w" value="Bastion subnet 10.144.204.32/28" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F6E8;strokeColor=#7AA116;fontColor=#248814;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;container=1;collapsible=0;spacingLeft=80;" vertex="1" parent="az3_w">
          <mxGeometry x="8" y="543" width="444" height="92" as="geometry" />
        </mxCell>
        <mxCell id="nobas3_w" value="No instance in this zone" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=9;fontColor=#545B64;" vertex="1" parent="bas3_w">
          <mxGeometry x="82" y="47" width="140" height="18" as="geometry" />
        </mxCell>
        <mxCell id="prv3_w" value="Private subnet 10.144.128.0/18" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6F6F7;strokeColor=#00A4A6;fontColor=#147EBA;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;container=1;collapsible=0;spacingLeft=80;" vertex="1" parent="az3_w">
          <mxGeometry x="8" y="643" width="444" height="458" as="geometry" />
        </mxCell>
        <mxCell id="int3_w" value="Internal subnet 10.144.216.0/22: local routes only" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#7D8998;fontColor=#545B64;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;container=1;collapsible=0;" vertex="1" parent="az3_w">
          <mxGeometry x="8" y="1109" width="444" height="120" as="geometry" />
        </mxCell>
        <mxCell id="igw_w" value="Internet&lt;br&gt;gateway" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.internet_gateway;fontStyle=1;labelBackgroundColor=#FFFFFF;" vertex="1" parent="vpc_w">
          <mxGeometry x="-18" y="442" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="ealb_w" value="&lt;b&gt;Public ALB prod01-usw2-edge&lt;/b&gt; &lt;font style=&quot;font-size:9px&quot; color=&quot;#687078&quot;&gt;prod01-us-west-2/edge&lt;/font&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;strokeWidth=1.5;fontColor=#232F3E;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="vpc_w">
          <mxGeometry x="34" y="130" width="1376" height="230" as="geometry" />
        </mxCell>
        <mxCell id="a1_w" value="&lt;b&gt;Load balancer&lt;/b&gt;: internet-facing, in the three public subnets; security group prod01-usw2-edge-sg allows 80 and 443 from anywhere, sends only to 10.144.0.0/16. HTTP/2 on, idle timeout 60 s, deletion protection off. Access logs on." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingRight=6;spacingTop=4;spacingLeft=50;container=1;collapsible=0;" vertex="1" parent="ealb_w">
          <mxGeometry x="12" y="28" width="220" height="194" as="geometry" />
        </mxCell>
        <mxCell id="a1_i_w" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.application_load_balancer;" vertex="1" parent="a1_w">
          <mxGeometry x="8" y="8" width="34" height="34" as="geometry" />
        </mxCell>
        <mxCell id="a2_w" value="&lt;b&gt;Listeners&lt;/b&gt;&lt;br&gt;HTTP 80: 301 to HTTPS 443.&lt;br&gt;HTTPS 443: ELBSecurityPolicy-TLS13-1-2-2021-06; ACM certificates for app., api. and load. (SNI); default action: fixed 403 Forbidden." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingRight=6;spacingTop=4;spacingLeft=50;container=1;collapsible=0;" vertex="1" parent="ealb_w">
          <mxGeometry x="246" y="28" width="200" height="194" as="geometry" />
        </mxCell>
        <mxCell id="a2_i_w" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.certificate_manager;" vertex="1" parent="a2_w">
          <mxGeometry x="8" y="8" width="34" height="34" as="geometry" />
        </mxCell>
        <mxCell id="a3_w" value="&lt;b&gt;WAF web ACL&lt;/b&gt; prod01-usw2-edge-lb-web-acl, REGIONAL, default allow. Rules by priority: 2 IP reputation list, 3 Common Rule Set, 4 blacklisted-ips (empty IP set), 5 SQLi, 6 Known Bad Inputs, 7 rate-limit-per-ip above 2000 per IP (default 300 s window). A blocked request gets 403." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingRight=6;spacingTop=4;spacingLeft=50;container=1;collapsible=0;" vertex="1" parent="ealb_w">
          <mxGeometry x="460" y="28" width="250" height="194" as="geometry" />
        </mxCell>
        <mxCell id="a3_i_w" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.waf;" vertex="1" parent="a3_w">
          <mxGeometry x="8" y="8" width="34" height="34" as="geometry" />
        </mxCell>
        <mxCell id="a4_w" value="&lt;b&gt;Listener rules&lt;/b&gt; (host header)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingRight=6;spacingTop=4;spacingLeft=8;container=1;collapsible=0;fillColor=#F4F6F8;" vertex="1" parent="ealb_w">
          <mxGeometry x="724" y="28" width="232" height="194" as="geometry" />
        </mxCell>
        <mxCell id="r10_w" value="&lt;b&gt;Priority 10&lt;/b&gt;, host api.&lt;br&gt;&lt;b&gt;Priority 20&lt;/b&gt;, host load.&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#687078&quot;&gt;app-services/of-api, of-load&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingRight=6;spacingTop=4;spacingLeft=6;fontSize=10;" vertex="1" parent="a4_w">
          <mxGeometry x="8" y="24" width="216" height="52" as="geometry" />
        </mxCell>
        <mxCell id="r100_w" value="&lt;b&gt;Priority 100&lt;/b&gt;, host&lt;br&gt;app.prod.innovate.example&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#687078&quot;&gt;prod01-us-west-2/edge&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingRight=6;spacingTop=4;spacingLeft=6;fontSize=10;" vertex="1" parent="a4_w">
          <mxGeometry x="8" y="82" width="216" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rdef_w" value="&lt;b&gt;No match&lt;/b&gt;: fixed 403" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingRight=6;spacingTop=4;spacingLeft=6;fontSize=10;verticalAlign=middle;spacingTop=0;" vertex="1" parent="a4_w">
          <mxGeometry x="8" y="150" width="216" height="38" as="geometry" />
        </mxCell>
        <mxCell id="tg1_w" value="&lt;b&gt;Target groups prod01-usw2-of-api-&amp;lt;hash&amp;gt; and prod01-usw2-of-load-&amp;lt;hash&amp;gt;&lt;/b&gt;: ip targets, HTTP 8000, health check /healthz; each chart's TargetGroupBinding fills its group." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingRight=6;spacingTop=4;spacingLeft=8;" vertex="1" parent="ealb_w">
          <mxGeometry x="968" y="28" width="282" height="92" as="geometry" />
        </mxCell>
        <mxCell id="tg2_w" value="&lt;b&gt;Target group prod01-usw2-edge-ingress&lt;/b&gt;: ip targets, HTTP 8000, health check 8080 /ping. Only the traefik stack (kept out) registers targets: on the rollout it is empty and the ALB answers 503." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingRight=6;spacingTop=4;spacingLeft=8;fillColor=#FFF5F3;strokeColor=#D13212;strokeWidth=2;" vertex="1" parent="ealb_w">
          <mxGeometry x="968" y="128" width="282" height="94" as="geometry" />
        </mxCell>
        <mxCell id="calb_w" value="&lt;b&gt;Ingress ALB, group prod01-usw2-eks&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;strokeWidth=1.5;fontColor=#232F3E;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="vpc_w">
          <mxGeometry x="46" y="375" width="854" height="160" as="geometry" />
        </mxCell>
        <mxCell id="b1_w" value="&lt;b&gt;Load balancer&lt;/b&gt; made in the cluster by the AWS Load Balancer Controller from the Argo CD Ingress; no Terraform resource. Internet-facing, public subnets, ip targets, its own security group. No WAF web ACL: the Ingress sets none." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingRight=6;spacingTop=4;spacingLeft=50;container=1;collapsible=0;" vertex="1" parent="calb_w">
          <mxGeometry x="12" y="28" width="240" height="125" as="geometry" />
        </mxCell>
        <mxCell id="b1_i_w" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.application_load_balancer;" vertex="1" parent="b1_w">
          <mxGeometry x="8" y="8" width="34" height="34" as="geometry" />
        </mxCell>
        <mxCell id="b2_w" value="&lt;b&gt;Listener&lt;/b&gt; HTTPS 443 only. Certificate: argocd-usw2. from the argocd stack (ACM, DNS-validated)." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingRight=6;spacingTop=4;spacingLeft=50;container=1;collapsible=0;" vertex="1" parent="calb_w">
          <mxGeometry x="264" y="28" width="230" height="125" as="geometry" />
        </mxCell>
        <mxCell id="b2_i_w" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.certificate_manager;" vertex="1" parent="b2_w">
          <mxGeometry x="8" y="8" width="34" height="34" as="geometry" />
        </mxCell>
        <mxCell id="b3_w" value="&lt;b&gt;Host rules&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingRight=6;spacingTop=4;spacingLeft=8;container=1;collapsible=0;fillColor=#F4F6F8;" vertex="1" parent="calb_w">
          <mxGeometry x="506" y="28" width="338" height="125" as="geometry" />
        </mxCell>
        <mxCell id="rc1_w" value="&lt;b&gt;Host argocd-usw2.&lt;/b&gt; to the argocd-server pods" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingRight=6;spacingTop=4;spacingLeft=6;" vertex="1" parent="b3_w">
          <mxGeometry x="10" y="25" width="154" height="92" as="geometry" />
        </mxCell>
        <mxCell id="rc2_w" value="&lt;b&gt;Any other host&lt;/b&gt;: the controller's fixed 404. Nothing serves app. here any more." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingRight=6;spacingTop=4;spacingLeft=6;" vertex="1" parent="b3_w">
          <mxGeometry x="174" y="25" width="154" height="92" as="geometry" />
        </mxCell>
        <mxCell id="gapnote_w" value="&lt;b&gt;Gap in the code (app.)&lt;/b&gt;: app. resolves to the accelerator and reaches rule 100 of the public ALB, whose target group only the traefik stack (kept out) would fill, so the ALB answers 503. Nothing serves app. any more: the web app calls api. and load. The accelerator stack still owns the app. record." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingRight=6;spacingTop=4;spacingLeft=8;fillColor=#FFF5F3;strokeColor=#D13212;strokeWidth=2;fontSize=10;" vertex="1" parent="vpc_w">
          <mxGeometry x="1052" y="375" width="316" height="160" as="geometry" />
        </mxCell>
        <mxCell id="comp_w" value="&lt;b&gt;Add-ons and components&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#687078&quot;&gt;cluster/eks, cluster/eks/components&lt;/font&gt;&lt;br&gt;EKS add-ons: vpc-cni, kube-proxy, eks-pod-identity-agent, coredns, aws-secrets-store-csi-driver-provider, aws-ebs-csi-driver&lt;br&gt;Helm: karpenter 1.14.1, aws-load-balancer-controller 3.5.0, external-dns 1.22.0, metrics-server 3.14.0, argo-cd 10.9.4, argocd-apps 2.0.6&lt;br&gt;Namespaces ingress, of, monitoring; default StorageClass gp3&lt;br&gt;Kept out: keda, traefik" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingRight=6;spacingTop=4;spacingLeft=44;container=1;collapsible=0;" vertex="1" parent="vpc_w">
          <mxGeometry x="34" y="746" width="270" height="186" as="geometry" />
        </mxCell>
        <mxCell id="comp_i_w" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eks;" vertex="1" parent="comp_w">
          <mxGeometry x="8" y="8" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="ialb_w" value="&lt;b&gt;Internal ALB&lt;/b&gt; prod01-usw2-internal-alb&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#687078&quot;&gt;prod01-us-west-2/internal-alb&lt;/font&gt;&lt;br&gt;Private subnets, HTTP 80 only. Rule 100: *.internal.prod.innovate.example to prod01-usw2-internal-ingress, which only traefik (kept out) fills; otherwise 404 JSON. Security group: 80 and 443 from 10.144.0.0/16. Serves nothing on the rollout." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingRight=6;spacingTop=4;spacingLeft=44;container=1;collapsible=0;" vertex="1" parent="vpc_w">
          <mxGeometry x="316" y="746" width="200" height="186" as="geometry" />
        </mxCell>
        <mxCell id="ialb_i_w" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.application_load_balancer;" vertex="1" parent="ialb_w">
          <mxGeometry x="8" y="8" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="argo_w" value="&lt;b&gt;Argo CD&lt;/b&gt; (namespace argocd): server, repo server and application controller, 2 replicas each, plus redis; no node selector. Sign-in: the built-in admin account, no SSO. Applications prod01-usw2-of-api and prod01-usw2-of-load, created by their app-services stacks: of-helm charts/of-api and charts/of-load at master; sync automated, prune and self-heal on." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingRight=6;spacingTop=4;spacingLeft=44;container=1;collapsible=0;" vertex="1" parent="vpc_w">
          <mxGeometry x="528" y="746" width="260" height="186" as="geometry" />
        </mxCell>
        <mxCell id="argo_i_w" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.container_1;" vertex="1" parent="argo_w">
          <mxGeometry x="8" y="8" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="ofapi_w" value="&lt;b&gt;of-api pods&lt;/b&gt; (namespace of-api, service-0.3.2): chart of-helm charts/of-api, written by the app-services stack and synced by Argo CD; image from ECR of-api at the commit tag in values.yaml; 2 to 5 replicas (HPA at 70% CPU); port 8000, /healthz; values-amd64: x86 nodes. Secrets through the CSI driver with Pod Identity (role prod01-usw2-eks-of-api-secrets): prod01-usw2-of-api (TOKEN_TTL_SECONDS, CORS_ALLOWED_ORIGINS) and prod01-usw2-aurora-database (DB_*), which has no source while Aurora is kept out. A sync hook job runs flask init-db before each rollout." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingRight=6;spacingTop=4;spacingLeft=44;container=1;collapsible=0;" vertex="1" parent="vpc_w">
          <mxGeometry x="800" y="746" width="330" height="186" as="geometry" />
        </mxCell>
        <mxCell id="ofapi_i_w" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.container_1;" vertex="1" parent="ofapi_w">
          <mxGeometry x="8" y="8" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="exapi_w" value="&lt;b&gt;of-load pods&lt;/b&gt; (namespace of-load, service-0.4): chart of-helm charts/of-load, written by its stack and synced by Argo CD; image from ECR of-load; 2 to 20 replicas (HPA at 70% CPU or 75% memory); port 8000, /healthz; values-arm64: Graviton nodes. Secrets through the CSI driver with Pod Identity (role prod01-usw2-eks-of-load-secrets): prod01-usw2-of-load (OF_API_URL, CORS_ALLOWED_ORIGINS). Security group rules: public ALB to the cluster security group on TCP 8000." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingRight=6;spacingTop=4;spacingLeft=44;container=1;collapsible=0;" vertex="1" parent="vpc_w">
          <mxGeometry x="1142" y="746" width="268" height="186" as="geometry" />
        </mxCell>
        <mxCell id="exapi_i_w" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.container_1;" vertex="1" parent="exapi_w">
          <mxGeometry x="8" y="8" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="nodes_w" value="&lt;b&gt;Nodes&lt;/b&gt; in the private subnets of all three zones; node security group prod01-usw2-eks: all traffic from 10.144.0.0/16, plus the EKS cluster security group" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;strokeWidth=1.5;fontColor=#232F3E;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="vpc_w">
          <mxGeometry x="34" y="998" width="1376" height="166" as="geometry" />
        </mxCell>
        <mxCell id="mng_w" value="&lt;b&gt;Managed node groups&lt;/b&gt;, label role=system, no taints&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#687078&quot;&gt;prod01-us-west-2/cluster/eks&lt;/font&gt;&lt;br&gt;spot-arm-ng-1: t4g.large Graviton (arm64), Spot, 1 to 10 nodes&lt;br&gt;spot-x86-ng-1: t3.large or t3a.large (x86), Spot, 1 to 10 nodes&lt;br&gt;AL2023, gp3 root 150 GiB, IMDSv2 hop limit 2. Karpenter, the load balancer controller and metrics-server run here." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingRight=6;spacingTop=4;spacingLeft=50;container=1;collapsible=0;" vertex="1" parent="nodes_w">
          <mxGeometry x="12" y="28" width="320" height="130" as="geometry" />
        </mxCell>
        <mxCell id="mng_i_w" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;" vertex="1" parent="mng_w">
          <mxGeometry x="8" y="8" width="34" height="34" as="geometry" />
        </mxCell>
        <mxCell id="npx_w" value="&lt;b&gt;Karpenter NodePool x86&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#687078&quot;&gt;cluster/eks/components/karpenter&lt;/font&gt;&lt;br&gt;amd64; Spot and On-Demand; families c, m, r, generation above 5; CPU limit 100 vCPU; weight 100; no taint.&lt;br&gt;of-api pods land here or on spot-x86-ng-1." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingRight=6;spacingTop=4;spacingLeft=50;container=1;collapsible=0;" vertex="1" parent="nodes_w">
          <mxGeometry x="344" y="28" width="310" height="130" as="geometry" />
        </mxCell>
        <mxCell id="npx_i_w" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;" vertex="1" parent="npx_w">
          <mxGeometry x="8" y="8" width="34" height="34" as="geometry" />
        </mxCell>
        <mxCell id="npg_w" value="&lt;b&gt;Karpenter NodePool graviton&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#687078&quot;&gt;cluster/eks/components/karpenter&lt;/font&gt;&lt;br&gt;arm64 (Graviton); Spot and On-Demand; families c, m, r, generation above 5; CPU limit 50 vCPU; weight 10; taint arch=arm64:NoSchedule.&lt;br&gt;of-api and of-load pods land here or on spot-arm-ng-1." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingRight=6;spacingTop=4;spacingLeft=50;container=1;collapsible=0;" vertex="1" parent="nodes_w">
          <mxGeometry x="666" y="28" width="310" height="130" as="geometry" />
        </mxCell>
        <mxCell id="npg_i_w" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;" vertex="1" parent="npg_w">
          <mxGeometry x="8" y="8" width="34" height="34" as="geometry" />
        </mxCell>
        <mxCell id="ncls_w" value="&lt;b&gt;Both NodePools&lt;/b&gt;: EC2NodeClass default, AL2023, 50 GiB gp3 encrypted, IMDSv2 hop limit 1; subnets and security groups found by the tag karpenter.sh/discovery = prod01-usw2-eks. Consolidation WhenEmptyOrUnderutilized after 1 minute, at most 10% of nodes at once; nodes expire after 720 h. The Karpenter controller reads Spot and health events from the interruption queue." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingRight=6;spacingTop=4;spacingLeft=8;" vertex="1" parent="nodes_w">
          <mxGeometry x="988" y="28" width="376" height="130" as="geometry" />
        </mxCell>
        <mxCell id="aurora_w" value="&lt;b&gt;Aurora global secondary: in code, kept out of the walk&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#687078&quot;&gt;prod01-us-west-2/aurora&lt;/font&gt;&lt;br&gt;aurora-secondary-1.0.1 (db.r6g.large, no write forwarding) and its RDS Proxy would join the us-east-1 global database, but create_global_cluster is off there and the stack is not in this region's stacks file. Not built yet; nothing listens on 5432 here." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingRight=6;spacingTop=4;spacingLeft=50;container=1;collapsible=0;fillColor=#F7F7F7;strokeColor=#545B64;dashed=1;dashPattern=6 4;" vertex="1" parent="vpc_w">
          <mxGeometry x="34" y="1208" width="1376" height="88" as="geometry" />
        </mxCell>
        <mxCell id="aurora_i_w" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.aurora;opacity=60;" vertex="1" parent="aurora_w">
          <mxGeometry x="8" y="8" width="34" height="34" as="geometry" />
        </mxCell>
        <mxCell id="l_argo_w" value="Argo CD pulls charts from of-helm over HTTPS (repository Secret helm-repo)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=9;fontColor=#545B64;" vertex="1" parent="vpc_w">
          <mxGeometry x="570" y="982" width="420" height="14" as="geometry" />
        </mxCell>
        <mxCell id="l_csi_w" value="CSI driver mounts with Pod Identity: prod01-usw2-eks-&amp;lt;app&amp;gt;-secrets reads the app secret; of-api's database secret has no source while Aurora is kept out" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=9;fontColor=#545B64;" vertex="1" parent="vpc_w">
          <mxGeometry x="984" y="933" width="446" height="14" as="geometry" />
        </mxCell>
        <mxCell id="l_gap_w" value="no targets registered: 503" style="text;html=1;align=left;verticalAlign=middle;fontSize=9;fontColor=#D13212;fontStyle=1;" vertex="1" parent="vpc_w">
          <mxGeometry x="1046" y="680" width="150" height="14" as="geometry" />
        </mxCell>
        <mxCell id="eks_w" value="&lt;b&gt;EKS control plane prod01-usw2-eks&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#687078&quot;&gt;prod01-us-west-2/cluster/eks&lt;/font&gt;&lt;br&gt;Kubernetes 1.36, run by AWS, network interfaces in the private subnets. Endpoint: private on; public on, open only to the IP of the machine running Terraform (/32). Authentication API_AND_CONFIG_MAP; access entries: the identity running Terraform (cluster admin), the Karpenter node role, the of-helm CI role (edit in namespace of); no developer entry, system/access reads only the us-east-1 cluster. No control plane logs; no customer KMS key for Secrets." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingRight=6;spacingTop=4;spacingLeft=50;container=1;collapsible=0;" vertex="1" parent="reg_w">
          <mxGeometry x="1490" y="350" width="284" height="206" as="geometry" />
        </mxCell>
        <mxCell id="eks_i_w" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eks;" vertex="1" parent="eks_w">
          <mxGeometry x="8" y="8" width="34" height="34" as="geometry" />
        </mxCell>
        <mxCell id="acm_w" value="&lt;b&gt;Certificate Manager&lt;/b&gt;, us-west-2: app. (edge stack), api. and load. (their app-services stacks), argocd-usw2. (argocd stack), each validated by DNS records in the public zone. The CloudFront certificate belongs to the frontend stack." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingRight=6;spacingTop=4;spacingLeft=50;container=1;collapsible=0;" vertex="1" parent="reg_w">
          <mxGeometry x="1490" y="572" width="284" height="118" as="geometry" />
        </mxCell>
        <mxCell id="acm_i_w" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.certificate_manager;" vertex="1" parent="acm_w">
          <mxGeometry x="8" y="8" width="34" height="34" as="geometry" />
        </mxCell>
        <mxCell id="pid_w" value="&lt;b&gt;EKS Pod Identity&lt;/b&gt; (eks-pod-identity-agent add-on): Karpenter, the EBS CSI driver, the load balancer controller and external-dns each assume their own IAM role, trusted by pods.eks.amazonaws.com; external-dns may change records in the public zone only. of-api and of-load pods assume prod01-usw2-eks-&amp;lt;app&amp;gt;-secrets, which reads only their secrets. IRSA: the cluster's OIDC provider exists, no role trusts it." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingRight=6;spacingTop=4;spacingLeft=50;container=1;collapsible=0;" vertex="1" parent="reg_w">
          <mxGeometry x="1490" y="706" width="284" height="146" as="geometry" />
        </mxCell>
        <mxCell id="pid_i_w" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management;" vertex="1" parent="pid_w">
          <mxGeometry x="8" y="8" width="34" height="34" as="geometry" />
        </mxCell>
        <mxCell id="sm_w" value="&lt;b&gt;Secrets Manager&lt;/b&gt; (module sm-03): prod01-usw2-of-api and prod01-usw2-of-load, written by the app-services stacks; prod01-usw2-failover-regional, the failover function's targets. No database secret: the Aurora stack is kept out." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingRight=6;spacingTop=4;spacingLeft=50;container=1;collapsible=0;" vertex="1" parent="reg_w">
          <mxGeometry x="1490" y="1172" width="284" height="124" as="geometry" />
