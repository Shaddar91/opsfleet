        <mxCell id="az3_w" value="Availability Zone 3" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_availability_zone;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=11;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;strokeColor=#147EBA;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;dashed=0;" vertex="1" parent="vpc_w">
          <mxGeometry x="966" y="75" width="460" height="1239" as="geometry" />
        </mxCell>
        <mxCell id="pub3_w" value="Public subnet 10.144.200.0/22" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F6E8;strokeColor=#7AA116;fontColor=#248814;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;container=1;collapsible=0;" vertex="1" parent="az3_w">
