        </mxCell>
        <mxCell id="s_pub_t" value="Public and bastion subnets: route to the internet gateway" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#232F3E;" vertex="1" parent="leg">
          <mxGeometry x="58" y="346" width="214" height="32" as="geometry" />
        </mxCell>
