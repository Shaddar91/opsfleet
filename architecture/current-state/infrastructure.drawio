<mxfile host="app.diagrams.net">
  <diagram id="current-infrastructure" name="Current state: infrastructure">
    <mxGraphModel dx="3100" dy="2000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3100" pageHeight="2000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Current state: how a request travels, from the user side" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="12" width="1700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Drawn from the Terraform code; it makes no claim about what is deployed today." style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#545B64;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="1700" height="24" as="geometry" />
        </mxCell>
        <mxCell id="subtitle2" value="Every AWS part on this page sits in the one AWS account that the organization diagram shows. Small grey text names the Terraform stack that creates a part." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#687078;" vertex="1" parent="1">
          <mxGeometry x="40" y="76" width="1700" height="18" as="geometry" />
        </mxCell>
        <mxCell id="user" value="End user&lt;br&gt;(browser)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.client;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="640" width="70" height="70" as="geometry" />
        </mxCell>
        <mxCell id="gb" value="Global services" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#AAB7B8;fontColor=#232F3E;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="230" y="120" width="680" height="860" as="geometry" />
        </mxCell>
        <mxCell id="r53" value="&lt;b&gt;Route 53 public zone&lt;br&gt;prod.innovate.example&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#687078&quot;&gt;system/r53/opsfleet&lt;/font&gt;&lt;br&gt;Delegated from the parent zone innovate.example by an NS record (TTL 300).&lt;br&gt;&lt;br&gt;&lt;b&gt;Records on these paths&lt;/b&gt;&lt;br&gt;web. and the apex: A alias to CloudFront&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#687078&quot;&gt;global/frontend&lt;/font&gt;&lt;br&gt;app.: A alias to the accelerator&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#687078&quot;&gt;global/global-accelerator&lt;/font&gt;&lt;br&gt;api.: A alias to the accelerator, target health evaluated&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#687078&quot;&gt;prod01-us-east-1/app-services/of-api&lt;/font&gt;&lt;br&gt;load.: A alias to the accelerator&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#687078&quot;&gt;prod01-us-east-1/app-services/of-load&lt;/font&gt;&lt;br&gt;argocd.: written by external-dns from the Argo CD Ingress host&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#687078&quot;&gt;cluster/eks/components/external-dns&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Also in the zone&lt;/b&gt;: certificate validation records (TTL 60); mail lockdown: null MX, SPF -all, DMARC reject.&lt;br&gt;&lt;br&gt;&lt;b&gt;Internal zone&lt;/b&gt; internal-prod.innovate.example: a public zone too; the Aurora stack writes the proxy records prod01-us-aurora-pool and prod01-us-aurora-ro into it. The internal ALB host *.internal.prod.innovate.example has no record.&lt;br&gt;&lt;br&gt;&lt;b&gt;Health checks&lt;/b&gt;: none built; the accelerator's Route 53 check is off." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingRight=6;spacingTop=4;spacingLeft=50;container=1;collapsible=0;" vertex="1" parent="gb">
          <mxGeometry x="16" y="300" width="254" height="520" as="geometry" />
        </mxCell>
        <mxCell id="r53_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.route_53;" vertex="1" parent="r53">
          <mxGeometry x="8" y="8" width="34" height="34" as="geometry" />
        </mxCell>
        <mxCell id="cfg" value="&lt;b&gt;Path A edge: CloudFront&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#687078&quot;&gt;global/frontend: applied by hand (init.sh, terraform apply), outside the region walk&lt;/font&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;fontColor=#232F3E;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="gb">
          <mxGeometry x="370" y="40" width="294" height="394" as="geometry" />
        </mxCell>
        <mxCell id="cf1" value="&lt;b&gt;Distribution&lt;/b&gt;: aliases web. and the apex; ACM certificate (us-east-1) for both; TLSv1.2_2021, SNI only; HTTP redirected to HTTPS; IPv4 only; PriceClass_100. Error responses: origin 403 and 404 become /index.html with 200." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingRight=6;spacingTop=4;spacingLeft=46;container=1;collapsible=0;" vertex="1" parent="cfg">
          <mxGeometry x="10" y="40" width="274" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cf1_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;" vertex="1" parent="cf1">
          <mxGeometry x="8" y="8" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cf2" value="&lt;b&gt;WAF web ACL&lt;/b&gt; innovate-inc-frontend-cf-web-acl, scope CLOUDFRONT, default allow: IP reputation list, Common Rule Set, Known Bad Inputs; rate-limit-per-ip answers 429 above 2000 requests per IP in 300 s." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingRight=6;spacingTop=4;spacingLeft=46;container=1;collapsible=0;" vertex="1" parent="cfg">
          <mxGeometry x="10" y="136" width="274" height="86" as="geometry" />
        </mxCell>
        <mxCell id="cf2_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.waf;" vertex="1" parent="cf2">
          <mxGeometry x="8" y="8" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cf3" value="&lt;b&gt;Viewer request&lt;/b&gt;: CloudFront Function apex-redirect sends the apex to web. with a 301. One cache behavior: GET and HEAD, Managed-CachingOptimized, compression on." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingRight=6;spacingTop=4;spacingLeft=46;container=1;collapsible=0;" vertex="1" parent="cfg">
          <mxGeometry x="10" y="228" width="274" height="70" as="geometry" />
        </mxCell>
        <mxCell id="cf3_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.cloudfront_functions;" vertex="1" parent="cf3">
          <mxGeometry x="8" y="8" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cf4" value="&lt;b&gt;Lambda@Edge&lt;/b&gt; innovate-inc-frontend-security-headers: origin request sets the origin secret as User-Agent; origin response adds HSTS, nosniff, X-XSS-Protection, Referrer-Policy and CORS headers for web. Logs kept 30 days." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingRight=6;spacingTop=4;spacingLeft=46;container=1;collapsible=0;" vertex="1" parent="cfg">
          <mxGeometry x="10" y="304" width="274" height="86" as="geometry" />
        </mxCell>
        <mxCell id="cf4_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.lambda_function;" vertex="1" parent="cf4">
          <mxGeometry x="8" y="8" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="ga" value="&lt;b&gt;Global Accelerator&lt;/b&gt;&lt;br&gt;innovate-inc-edge-accelerator&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#687078&quot;&gt;global/global-accelerator&lt;/font&gt;&lt;br&gt;Static anycast IPv4 addresses. Listener web: TCP 80 and 443, client affinity none.&lt;br&gt;&lt;b&gt;Endpoint groups us-east-1 and us-west-2&lt;/b&gt;, each added by its region's edge stack: traffic dial 100, health check TCP 443 every 30 s, threshold 3; endpoint: that region's public ALB, weight 100, client IP preservation on. Clients go to the nearest healthy region; the failover function sets a failed region's dial to 0.&lt;br&gt;No Route 53 health check; no flow logs." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingRight=6;spacingTop=4;spacingLeft=50;container=1;collapsible=0;" vertex="1" parent="gb">
          <mxGeometry x="370" y="440" width="294" height="230" as="geometry" />
        </mxCell>
        <mxCell id="ga_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.global_accelerator;" vertex="1" parent="ga">
          <mxGeometry x="8" y="8" width="34" height="34" as="geometry" />
        </mxCell>
        <mxCell id="reg" value="Region us-east-1" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;strokeColor=#00A4A6;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="930" y="100" width="1790" height="1673" as="geometry" />
        </mxCell>
        <mxCell id="webb" value="&lt;b&gt;Web bucket&lt;/b&gt; &amp;lt;web-bucket&amp;gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#687078&quot;&gt;global/frontend&lt;/font&gt;&lt;br&gt;S3 website endpoint, fetched by CloudFront over HTTP. The bucket policy gives s3:GetObject to any caller whose User-Agent equals the origin secret, so in practice only CloudFront gets objects; no origin access control. Versioning on, SSE-S3; noncurrent versions expire after 7 days, the 3 newest kept." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingRight=6;spacingTop=4;spacingLeft=50;container=1;collapsible=0;" vertex="1" parent="reg">
          <mxGeometry x="20" y="172" width="360" height="138" as="geometry" />
        </mxCell>
        <mxCell id="webb_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.bucket;" vertex="1" parent="webb">
          <mxGeometry x="8" y="8" width="34" height="34" as="geometry" />
        </mxCell>
        <mxCell id="logs" value="Log destinations" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#AAB7B8;fontColor=#232F3E;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="reg">
          <mxGeometry x="390" y="72" width="1080" height="176" as="geometry" />
        </mxCell>
        <mxCell id="cwl" value="&lt;b&gt;CloudWatch Logs&lt;/b&gt;&lt;br&gt;aws-waf-logs-innovate-inc-frontend-cf-web-acl: CloudFront WAF, 60 days, authorization and cookie headers redacted&lt;br&gt;prod01-us-network-vpc-flow-logs: VPC flow logs, REJECT only, 60 days" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingRight=6;spacingTop=4;spacingLeft=50;container=1;collapsible=0;" vertex="1" parent="logs">
          <mxGeometry x="12" y="24" width="318" height="140" as="geometry" />
        </mxCell>
        <mxCell id="cwl_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.cloudwatch_logs;" vertex="1" parent="cwl">
          <mxGeometry x="8" y="8" width="34" height="34" as="geometry" />
        </mxCell>
        <mxCell id="fh" value="&lt;b&gt;Firehose&lt;/b&gt; aws-waf-logs-prod01-us-edge, encrypted: public ALB WAF logs, user-agent header redacted" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingRight=6;spacingTop=4;spacingLeft=50;container=1;collapsible=0;" vertex="1" parent="logs">
          <mxGeometry x="342" y="24" width="238" height="140" as="geometry" />
        </mxCell>
        <mxCell id="fh_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.kinesis_data_firehose;" vertex="1" parent="fh">
          <mxGeometry x="8" y="8" width="34" height="34" as="geometry" />
        </mxCell>
        <mxCell id="elb" value="&lt;b&gt;Edge log bucket&lt;/b&gt; &amp;lt;edge-log-bucket&amp;gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#687078&quot;&gt;prod01-us-east-1/edge&lt;/font&gt;&lt;br&gt;ALB access logs under logs/, WAF logs under waf-logs/; objects expire after 180 days; all public access blocked" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingRight=6;spacingTop=4;spacingLeft=50;container=1;collapsible=0;" vertex="1" parent="logs">
          <mxGeometry x="592" y="24" width="270" height="140" as="geometry" />
        </mxCell>
        <mxCell id="elb_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.bucket;" vertex="1" parent="elb">
          <mxGeometry x="8" y="8" width="34" height="34" as="geometry" />
        </mxCell>
        <mxCell id="cflb" value="&lt;b&gt;CloudFront log bucket&lt;/b&gt; &amp;lt;log-bucket&amp;gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#687078&quot;&gt;global/frontend&lt;/font&gt;&lt;br&gt;Access logs off (enable_access_logs off): not built yet" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingRight=6;spacingTop=4;spacingLeft=50;container=1;collapsible=0;fillColor=#F7F7F7;strokeColor=#545B64;dashed=1;dashPattern=6 4;" vertex="1" parent="logs">
