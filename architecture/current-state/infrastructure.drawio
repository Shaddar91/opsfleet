        <mxCell id="prv2_w" value="Private subnet 10.144.64.0/18" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6F6F7;strokeColor=#00A4A6;fontColor=#147EBA;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;container=1;collapsible=0;" vertex="1" parent="az2_w">
          <mxGeometry x="8" y="643" width="444" height="458" as="geometry" />
