          <mxGeometry x="8" y="27" width="444" height="508" as="geometry" />
        </mxCell>
        <mxCell id="bas1" value="Bastion subnet 10.144.204.0/28" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F6E8;strokeColor=#7AA116;fontColor=#248814;fontSize=10;fontStyle=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=0;container=1;collapsible=0;" vertex="1" parent="az1">
