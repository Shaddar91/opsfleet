          <mxGeometry x="58" y="318" width="214" height="22" as="geometry" />
        </mxCell>
        <mxCell id="s_pub" value="" style="rounded=0;html=1;fillColor=#F2F6E8;strokeColor=#7AA116;" vertex="1" parent="leg">
