      <mxCell id="w2failover" value="&lt;b&gt;Regional failover function&lt;/b&gt;&lt;br&gt;Lambda in us-west-2 from the ECR of-failover image (arm64): sets a region's accelerator endpoint group dial to 0 and promotes the Aurora global database standby; its targets sit in the Secrets Manager secret prod01-usw2-failover-regional. Invoked by hand; on_alarm is status.&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#687078&quot;&gt;prod01-us-west-2/failover/lambda-regional-failover&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingRight=6;spacingTop=8;" vertex="1" parent="acct"><mxGeometry x="20" y="1028" width="1380" height="96" as="geometry" /></mxCell><mxCell id="gh_failover" value="&lt;b&gt;of-failover&lt;/b&gt;: the failover function (Python); Actions test it, build the arm64 image and push it to ECR of-failover" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;" vertex="1" parent="gh"><mxGeometry x="12" y="476" width="216" height="64" as="geometry" /></mxCell><mxCell id="e_fo_ga" value="sets a region's accelerator dial to 0" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#ED7100;fontSize=9;fontColor=#ED7100;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=8 5;edgeStyle=orthogonalEdgeStyle;exitX=0.05;exitY=0.0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="w2failover" target="ga"><mxGeometry relative="1" as="geometry"><Array><mxPoint x="379" y="1108" /><mxPoint x="304" y="1108" /><mxPoint x="304" y="230" /></Array></mxGeometry></mxCell><mxCell id="e_fo_aurora" value="promotes the Aurora standby" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeWidth=2;strokeColor=#ED7100;fontSize=9;fontColor=#ED7100;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=8 5;edgeStyle=orthogonalEdgeStyle;exitX=0.6;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="w2failover" target="aurora"><mxGeometry relative="1" as="geometry"><Array><mxPoint x="1378" y="1108" /><mxPoint x="1378" y="910" /></Array></mxGeometry></mxCell><mxCell id="ci_roles_w" value="&lt;b&gt;CI roles&lt;/b&gt;&lt;br&gt;prod01-usw2-of-api-ci-role and prod01-usw2-of-helm-ci-role, trusted through GitHub OIDC; of-helm's adds EKS edit access in namespace of. No workflow assumes them: image pushes use the system/ecr roles&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#687078&quot;&gt;prod01-us-west-2/ci/roles&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=2;" vertex="1" parent="r3">
          <mxGeometry x="16" y="40" width="240" height="100" as="geometry" />
        </mxCell>
