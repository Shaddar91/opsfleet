          <mxGeometry x="14" y="212" width="200" height="78" as="geometry" />
        </mxCell>
        <mxCell id="z_internal" value="&lt;b&gt;Internal zone&lt;/b&gt;&lt;br&gt;internal-prod.innovate.example&lt;br&gt;internal names" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2EBFF;strokeColor=#8C4FFF;fontColor=#232F3E;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="r53">
          <mxGeometry x="226" y="212" width="200" height="78" as="geometry" />
        </mxCell>
        <mxCell id="iam" value="&lt;b&gt;IAM&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=11;align=left;verticalAlign=top;spacingLeft=58;spacingRight=6;spacingTop=20;container=1;collapsible=0;" vertex="1" parent="glob">
          <mxGeometry x="908" y="34" width="456" height="306" as="geometry" />
        </mxCell>
        <mxCell id="iam_icon" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management;" vertex="1" parent="iam">
          <mxGeometry x="8" y="10" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="iam_group" value="&lt;b&gt;IAM group prod01-us-developers&lt;/b&gt;: ReadOnlyAccess; denies the state bucket, S3 access points, secret values and KMS decrypt through SSM or Secrets Manager; allows sts:AssumeRole on the deploy role. Members: &amp;lt;developer&amp;gt; IAM users.&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#687078&quot;&gt;system/access/developers&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD344C;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;" vertex="1" parent="iam">
          <mxGeometry x="12" y="62" width="432" height="74" as="geometry" />
        </mxCell>
        <mxCell id="iam_deploy" value="&lt;b&gt;Deploy role prod01-us-developers-deploy-role&lt;/b&gt;: trusts the account root; allows eks:DescribeCluster. Its EKS access entry grants AmazonEKSEditPolicy in namespace of.&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#687078&quot;&gt;system/access/developers&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD344C;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;" vertex="1" parent="iam">
          <mxGeometry x="12" y="142" width="432" height="58" as="geometry" />
        </mxCell>
        <mxCell id="iam_oidc" value="&lt;b&gt;GitHub OIDC provider&lt;/b&gt;, trusted by the CI roles&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#687078&quot;&gt;system/iam/github-oidc&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD344C;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;" vertex="1" parent="iam">
          <mxGeometry x="12" y="206" width="432" height="38" as="geometry" />
        </mxCell>
        <mxCell id="iam_tfci" value="&lt;b&gt;terraform-ci&lt;/b&gt;: plan role (ReadOnlyAccess, default branch) and apply role (AdministratorAccess, approval environment only) for this repository&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#687078&quot;&gt;system/iam/terraform-ci&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD344C;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;" vertex="1" parent="iam">
          <mxGeometry x="12" y="250" width="432" height="48" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="us-east-1" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;strokeColor=#00A4A6;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;dashed=0;" vertex="1" parent="acct">
          <mxGeometry x="20" y="412" width="1380" height="580" as="geometry" />
        </mxCell>
        <mxCell id="ci_roles" value="&lt;b&gt;CI roles&lt;/b&gt;&lt;br&gt;Roles for of-api and of-helm, one per repository, trusted through GitHub OIDC; EKS edit access in one namespace for each repository whose CI deploys to the cluster&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#687078&quot;&gt;prod01-us-east-1/ci/roles&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=2;" vertex="1" parent="r1">
          <mxGeometry x="16" y="40" width="240" height="84" as="geometry" />
        </mxCell>
        <mxCell id="ci_gha" value="&lt;b&gt;GitHub Actions settings&lt;/b&gt;: the AWS_ROLE_ARN secret, secrets and variables per repository&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#687078&quot;&gt;prod01-us-east-1/ci/github-actions&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=2;" vertex="1" parent="r1">
