        <mxCell id="bastion" value="&lt;b&gt;Bastion&lt;/b&gt;&lt;br&gt;Graviton Spot instance (t4g.small); Ansible runs at boot from the ansible bucket; key pair from system/ssh-key&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#687078&quot;&gt;prod01-us-east-1/network&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingLeft=56;spacingRight=4;spacingTop=6;container=1;collapsible=0;" vertex="1" parent="vpc">
          <mxGeometry x="516" y="44" width="240" height="118" as="geometry" />
        </mxCell>
        <mxCell id="bastion_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;" vertex="1" parent="bastion">
