        <mxCell id="alb_pub" value="&lt;b&gt;Public ALB&lt;/b&gt;&lt;br&gt;ACM certificate, HTTP to HTTPS redirect, WAF, access logs; endpoint group of the accelerator&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#687078&quot;&gt;prod01-us-east-1/edge&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingLeft=56;spacingRight=4;spacingTop=6;container=1;collapsible=0;" vertex="1" parent="vpc">
