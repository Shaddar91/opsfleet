        </mxCell>
        <mxCell id="key" value="&lt;b&gt;Bastion key pair&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#687078&quot;&gt;system/ssh-key&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=6;" vertex="1" parent="r1">
          <mxGeometry x="16" y="370" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;S3 buckets&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#687078&quot;&gt;system/s3&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=4;container=1;collapsible=0;" vertex="1" parent="r1">
