        <mxCell id="s3_bak_t" value="&lt;b&gt;backup-bucket&lt;/b&gt;: versioned, replicated to us-west-2" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#232F3E;" vertex="1" parent="s3">
          <mxGeometry x="42" y="108" width="192" height="34" as="geometry" />
        </mxCell>
        <mxCell id="vpc" value="&lt;b&gt;VPC 10.144.0.0/16 over three AZs&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#687078&quot;&gt;prod01-us-east-1/network&lt;/font&gt;" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_vpc2;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;strokeColor=#8C4FFF;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#6B40C4;dashed=0;" vertex="1" parent="r1">
          <mxGeometry x="288" y="40" width="772" height="536" as="geometry" />
        </mxCell>
        <mxCell id="alb_pub" value="&lt;b&gt;Public ALB&lt;/b&gt;&lt;br&gt;ACM certificates, HTTP to HTTPS redirect, WAF, access logs; host rules api. and load. to the app target groups, app. to the ingress group; endpoint group of the accelerator&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#687078&quot;&gt;prod01-us-east-1/edge&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingLeft=56;spacingRight=4;spacingTop=6;container=1;collapsible=0;" vertex="1" parent="vpc">
          <mxGeometry x="16" y="44" width="240" height="118" as="geometry" />
        </mxCell>
        <mxCell id="alb_pub_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.application_load_balancer;" vertex="1" parent="alb_pub">
          <mxGeometry x="8" y="10" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="alb_int" value="&lt;b&gt;Internal ALB&lt;/b&gt;&lt;br&gt;Private subnets; HTTP listener with a 404 default; ip target group for in-cluster ingress&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#687078&quot;&gt;prod01-us-east-1/internal-alb&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingLeft=56;spacingRight=4;spacingTop=6;container=1;collapsible=0;" vertex="1" parent="vpc">
          <mxGeometry x="266" y="44" width="240" height="118" as="geometry" />
        </mxCell>
        <mxCell id="alb_int_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.application_load_balancer;" vertex="1" parent="alb_int">
          <mxGeometry x="8" y="10" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="bastion" value="&lt;b&gt;Bastion&lt;/b&gt;&lt;br&gt;Graviton Spot instance (t4g.small); Ansible runs at boot from the ansible bucket; key pair from system/ssh-key&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#687078&quot;&gt;prod01-us-east-1/network&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingLeft=56;spacingRight=4;spacingTop=6;container=1;collapsible=0;" vertex="1" parent="vpc">
          <mxGeometry x="516" y="44" width="240" height="118" as="geometry" />
        </mxCell>
        <mxCell id="bastion_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;" vertex="1" parent="bastion">
          <mxGeometry x="8" y="10" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="eks" value="&lt;b&gt;EKS prod01-us-eks&lt;/b&gt;&lt;br&gt;Private subnets. Public endpoint open only to the Terraform runner's IP; the runner is cluster admin. One Graviton and one x86 Spot node group; a node access entry for Karpenter.&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#687078&quot;&gt;prod01-us-east-1/cluster/eks&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;fontColor=#232F3E;fontSize=11;align=left;verticalAlign=top;spacingLeft=62;spacingRight=6;spacingTop=8;container=1;collapsible=0;" vertex="1" parent="vpc">
          <mxGeometry x="16" y="176" width="490" height="200" as="geometry" />
        </mxCell>
        <mxCell id="eks_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eks;" vertex="1" parent="eks">
          <mxGeometry x="8" y="10" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="app" value="&lt;b&gt;of-api&lt;/b&gt;, &lt;b&gt;of-load&lt;/b&gt;&lt;br&gt;API service (service-0.3.2) and stress service (service-0.4): target group and host rule on the public ALB, ACM certificate, Route 53 record, Argo CD Application, chart written to of-helm, settings in Secrets Manager and a Pod Identity role that reads them&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#687078&quot;&gt;prod01-us-east-1/app-services: of-api, of-load&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;spacingTop=6;" vertex="1" parent="vpc">
          <mxGeometry x="516" y="176" width="240" height="116" as="geometry" />
        </mxCell>
