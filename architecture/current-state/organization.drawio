<mxfile host="app.diagrams.net">
  <diagram id="current-organization" name="Current state: organization">
    <mxGraphModel dx="2200" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Current state: one AWS account" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="290" y="14" width="1420" height="32" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Every environment and every shared service in one account. Small text names the Terraform stack (path under terraform/) that creates each part." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#545B64;" vertex="1" parent="1">
          <mxGeometry x="290" y="46" width="1420" height="24" as="geometry" />
        </mxCell>
        <mxCell id="acct" value="AWS account (standalone, no AWS Organization)" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=14;fontStyle=1;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;strokeColor=#CD2264;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#CD2264;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="290" y="90" width="1420" height="1174" as="geometry" />
        </mxCell>
        <mxCell id="glob" value="Global services" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#AAB7B8;fontColor=#232F3E;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=2;container=1;collapsible=0;" vertex="1" parent="acct">
          <mxGeometry x="20" y="40" width="1380" height="356" as="geometry" />
        </mxCell>
        <mxCell id="ga" value="&lt;b&gt;Global Accelerator&lt;/b&gt;&lt;br&gt;Static anycast IPs on TCP 80 and 443. Each region's edge stack attaches its public ALB as an endpoint group. Holds the A alias record of the app hostname.&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#687078&quot;&gt;global/global-accelerator&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=11;align=left;verticalAlign=top;spacingLeft=58;spacingRight=6;spacingTop=6;container=1;collapsible=0;" vertex="1" parent="glob">
          <mxGeometry x="16" y="34" width="420" height="132" as="geometry" />
        </mxCell>
        <mxCell id="ga_icon" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.global_accelerator;" vertex="1" parent="ga">
          <mxGeometry x="8" y="10" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="fe" value="&lt;b&gt;Frontend&lt;/b&gt;, deployed by name&lt;br&gt;CloudFront with WAF and an ACM certificate, in front of the S3 web bucket. Lambda@Edge stamps the origin secret and sets the security headers. Access logs go to a log bucket. Route 53 aliases for the web hostname and the zone apex. The of-web deploy role, its GitHub Actions secrets and workflow.&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#687078&quot;&gt;global/frontend; runs only by name: ./tfctl.sh global apply frontend&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=11;align=left;verticalAlign=top;spacingLeft=58;spacingRight=6;spacingTop=6;container=1;collapsible=0;" vertex="1" parent="glob">
          <mxGeometry x="16" y="180" width="420" height="160" as="geometry" />
        </mxCell>
        <mxCell id="fe_cf" value="CloudFront" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;" vertex="1" parent="fe">
          <mxGeometry x="8" y="10" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="r53" value="&lt;b&gt;Route 53&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#687078&quot;&gt;system/r53/opsfleet&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;fontColor=#232F3E;fontSize=11;align=left;verticalAlign=top;spacingLeft=58;spacingRight=6;spacingTop=14;container=1;collapsible=0;" vertex="1" parent="glob">
          <mxGeometry x="452" y="34" width="440" height="306" as="geometry" />
        </mxCell>
        <mxCell id="r53_icon" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.route_53;" vertex="1" parent="r53">
          <mxGeometry x="8" y="10" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="z_parent" value="&lt;b&gt;Parent zone&lt;/b&gt;&lt;br&gt;innovate.example, already in the account" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2EBFF;strokeColor=#8C4FFF;fontColor=#232F3E;fontSize=10;align=center;verticalAlign=middle;" vertex="1" parent="r53">
          <mxGeometry x="110" y="80" width="220" height="50" as="geometry" />
        </mxCell>
