        </mxCell>
        <mxCell id="f4w" value="&lt;b&gt;Dev, Staging, Prod&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#687078&quot;&gt;innovate-dev, innovate-staging, innovate-prod: one EKS cluster each&lt;/font&gt;" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;strokeColor=#CD2264;fillColor=#FFFFFF;verticalAlign=top;align=left;spacingLeft=30;fontColor=#CD2264;dashed=0;" vertex="1" parent="org">
          <mxGeometry x="40" y="1562" width="1400" height="246" as="geometry" />
        </mxCell>
        <mxCell id="argo" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Argo CD in each cluster&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Pull mode: reads the GitOps repository and applies to its own cluster only. No pipeline and no person connects to the Prod Kubernetes API from another account." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;align=left;spacingLeft=8;spacingTop=3;fontSize=11;" vertex="1" parent="f4w">
          <mxGeometry x="20" y="44" width="420" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pods" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Pods and controllers&lt;/font&gt;&lt;/b&gt;&lt;br&gt;As in the current state, inside each account: controllers and pods take AWS rights from EKS Pod Identity roles of that account; pods read Secrets Manager through the Secrets Store CSI driver." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;align=left;spacingLeft=46;spacingTop=3;fontSize=11;" vertex="1" parent="f4w">
          <mxGeometry x="500" y="44" width="440" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pods_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;" vertex="1" parent="pods">
          <mxGeometry x="8" y="8" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="gcw" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;grafana-cw-read&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Role in Dev, Staging and Prod, trusted by the Grafana role in Shared Services: read-only CloudWatch metrics and logs and Amazon Managed Prometheus (F12)." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;align=left;spacingLeft=46;spacingTop=3;fontSize=11;" vertex="1" parent="f4w">
          <mxGeometry x="980" y="44" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="gcw_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.role;dashed=0;" vertex="1" parent="gcw">
          <mxGeometry x="8" y="8" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="node" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;EKS node role&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Pulls images by digest from ECR in Shared Services through the ECR VPC endpoints (ecr.api, ecr.dkr, S3 gateway) of its VPC (F8). No network path between accounts." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;align=left;spacingLeft=46;spacingTop=3;fontSize=11;" vertex="1" parent="f4w">
          <mxGeometry x="20" y="146" width="420" height="84" as="geometry" />
        </mxCell>
        <mxCell id="node_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.role;dashed=0;" vertex="1" parent="node">
          <mxGeometry x="8" y="8" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="f4s" value="&lt;b&gt;Shared Services&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#687078&quot;&gt;innovate-shared-services&lt;/font&gt;" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;strokeColor=#CD2264;fillColor=#FFFFFF;verticalAlign=top;align=left;spacingLeft=30;fontColor=#CD2264;dashed=0;" vertex="1" parent="org">
          <mxGeometry x="1580" y="1562" width="720" height="246" as="geometry" />
        </mxCell>
        <mxCell id="graf" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Amazon Managed Grafana&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Dashboards and alert rules live here; the telemetry stays in the workload accounts." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;align=left;spacingLeft=46;spacingTop=3;fontSize=11;" vertex="1" parent="f4s">
          <mxGeometry x="20" y="44" width="680" height="90" as="geometry" />
        </mxCell>
        <mxCell id="graf_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.managed_service_for_grafana;" vertex="1" parent="graf">
          <mxGeometry x="8" y="8" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="ecr" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;ECR: one registry, one repository per service&lt;/font&gt;&lt;/b&gt;&lt;br&gt;The repository policy allows ecr:BatchGetImage, ecr:GetDownloadUrlForLayer and ecr:BatchCheckLayerAvailability to the EKS node roles of Dev, Staging and Prod." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;align=left;spacingLeft=46;spacingTop=3;fontSize=11;" vertex="1" parent="f4s">
          <mxGeometry x="20" y="146" width="680" height="84" as="geometry" />
        </mxCell>
        <mxCell id="ecr_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecr;" vertex="1" parent="ecr">
          <mxGeometry x="8" y="8" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="note4" value="&lt;b&gt;No Kubernetes API access crosses an account boundary.&lt;/b&gt; Argo CD runs inside each cluster. Two paths in this lane cross accounts: the image pull, by resource policy (F8), and Grafana&#x27;s read, by role assumption (F12)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;spacingLeft=12;spacingRight=12;spacingTop=8;strokeColor=#CD2264;fillColor=#FDF2F7;rounded=1;arcSize=4;" vertex="1" parent="org">
          <mxGeometry x="2340" y="1606" width="480" height="90" as="geometry" />
        </mxCell>
        <mxCell id="e4_pull" value="pulls" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeWidth=2.5;strokeColor=#8C4FFF;fontSize=11;fontColor=#545B64;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5778;entryDx=0;entryDy=0;" edge="1" parent="1" source="gitops" target="argo">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="e4_apply" value="applies" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeWidth=2.5;strokeColor=#8C4FFF;fontSize=11;fontColor=#545B64;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.5778;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5778;entryDx=0;entryDy=0;" edge="1" parent="1" source="argo" target="pods">
          <mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-18" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="e4_gcw" value="sts:AssumeRole,&lt;br&gt;cross-account (F12)" style="shape=flexArrow;endArrow=classic;html=1;rounded=0;fillColor=#CD2264;strokeColor=#CD2264;width=10;endSize=7;endWidth=24;fontSize=13;fontStyle=1;fontColor=#CD2264;labelBackgroundColor=#FFFFFF;exitX=0.0;exitY=0.5778;exitDx=0;exitDy=0;entryX=1.0;entryY=0.5778;entryDx=0;entryDy=0;" edge="1" parent="1" source="graf" target="gcw">
          <mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-40" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="e4_img" value="F8: image pull by digest; ECR repository policy, no role assumption" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=5;strokeWidth=1.5;strokeColor=#ED7100;fontSize=10;fontColor=#B35A00;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="node" target="ecr">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="strip" value="&lt;b&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Today to proposal&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB7B8;fontColor=#232F3E;fontSize=13;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1968" width="3720" height="240" as="geometry" />
        </mxCell>
        <mxCell id="s0_h" value="Who signs in" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#545B64;fontColor=#232F3E;" vertex="1" parent="strip">
          <mxGeometry x="16" y="36" width="516" height="22" as="geometry" />
        </mxCell>
        <mxCell id="s0_a" value="&lt;b&gt;Today:&lt;/b&gt; IAM users in the IAM group prod01-us-developers, each with a long-lived access key or a console password." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;rounded=1;arcSize=6;fillColor=#F4F6F8;strokeColor=#AAB7B8;" vertex="1" parent="strip">
          <mxGeometry x="16" y="62" width="516" height="66" as="geometry" />
        </mxCell>
        <mxCell id="s0_b" value="&lt;b&gt;Proposal:&lt;/b&gt; Users and groups in Google Workspace, provisioned to IAM Identity Center by SCIM. No IAM user in any account: the foundation SCP denies creating one." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#CD2264;" vertex="1" parent="strip">
          <mxGeometry x="16" y="152" width="516" height="76" as="geometry" />
        </mxCell>
        <mxCell id="s0_e" value="" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;strokeColor=#545B64;fontSize=11;fontColor=#545B64;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s0_a" target="s0_b">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="s1_h" value="Developer rights" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#545B64;fontColor=#232F3E;" vertex="1" parent="strip">
          <mxGeometry x="544" y="36" width="516" height="22" as="geometry" />
        </mxCell>
        <mxCell id="s1_a" value="&lt;b&gt;Today:&lt;/b&gt; prod01-us-developers-deploy-role, assumed with sts:AssumeRole, and an EKS access entry with AmazonEKSEditPolicy in namespace of." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;rounded=1;arcSize=6;fillColor=#F4F6F8;strokeColor=#AAB7B8;" vertex="1" parent="strip">
          <mxGeometry x="544" y="62" width="516" height="66" as="geometry" />
        </mxCell>
        <mxCell id="s1_b" value="&lt;b&gt;Proposal:&lt;/b&gt; AWSReservedSSO_Developer_&amp;lt;hash&amp;gt; in Dev, created from the Developer permission set, plus an EKS access entry for that role." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#CD2264;" vertex="1" parent="strip">
          <mxGeometry x="544" y="152" width="516" height="76" as="geometry" />
        </mxCell>
        <mxCell id="s1_e" value="" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;strokeColor=#545B64;fontSize=11;fontColor=#545B64;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1_a" target="s1_b">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="s2_h" value="MFA" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#545B64;fontColor=#232F3E;" vertex="1" parent="strip">
          <mxGeometry x="1072" y="36" width="516" height="22" as="geometry" />
        </mxCell>
        <mxCell id="s2_a" value="&lt;b&gt;Today:&lt;/b&gt; Not enforced: no condition in the deploy role trust policy and no mfa_serial in the operator profile." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;rounded=1;arcSize=6;fillColor=#F4F6F8;strokeColor=#AAB7B8;" vertex="1" parent="strip">
          <mxGeometry x="1072" y="62" width="516" height="66" as="geometry" />
        </mxCell>
        <mxCell id="s2_b" value="&lt;b&gt;Proposal:&lt;/b&gt; MFA at the IdP, once per sign-in, for every person and every account." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#CD2264;" vertex="1" parent="strip">
          <mxGeometry x="1072" y="152" width="516" height="76" as="geometry" />
        </mxCell>
        <mxCell id="s2_e" value="" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;strokeColor=#545B64;fontSize=11;fontColor=#545B64;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2_a" target="s2_b">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="s3_h" value="Operator" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#545B64;fontColor=#232F3E;" vertex="1" parent="strip">
          <mxGeometry x="1600" y="36" width="516" height="22" as="geometry" />
        </mxCell>
        <mxCell id="s3_a" value="&lt;b&gt;Today:&lt;/b&gt; A source profile access key assumes &amp;lt;terraform-role&amp;gt;, created outside this repository; tfctl.sh runs Terraform from the workstation." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;rounded=1;arcSize=6;fillColor=#F4F6F8;strokeColor=#AAB7B8;" vertex="1" parent="strip">
          <mxGeometry x="1600" y="62" width="516" height="66" as="geometry" />
        </mxCell>
        <mxCell id="s3_b" value="&lt;b&gt;Proposal:&lt;/b&gt; PlatformAdmin in Shared Services, Security Tooling and Dev; Staging and Prod change only through the pipeline." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#CD2264;" vertex="1" parent="strip">
          <mxGeometry x="1600" y="152" width="516" height="76" as="geometry" />
        </mxCell>
        <mxCell id="s3_e" value="" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;strokeColor=#545B64;fontSize=11;fontColor=#545B64;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3_a" target="s3_b">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="s4_h" value="CI roles" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#545B64;fontColor=#232F3E;" vertex="1" parent="strip">
          <mxGeometry x="2128" y="36" width="516" height="22" as="geometry" />
        </mxCell>
        <mxCell id="s4_a" value="&lt;b&gt;Today:&lt;/b&gt; terraform-ci (opsfleet-terraform-plan-role, opsfleet-terraform-apply-role) and the per-repository CI roles of of-api, of-web and of-helm, all in the one account." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;rounded=1;arcSize=6;fillColor=#F4F6F8;strokeColor=#AAB7B8;" vertex="1" parent="strip">
          <mxGeometry x="2128" y="62" width="516" height="66" as="geometry" />
        </mxCell>
        <mxCell id="s4_b" value="&lt;b&gt;Proposal:&lt;/b&gt; gha-deploy per account, gha-shared-deploy in Shared Services and gha-org-admin in Management; image pushes through gha-ecr-push in Shared Services." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#CD2264;" vertex="1" parent="strip">
          <mxGeometry x="2128" y="152" width="516" height="76" as="geometry" />
        </mxCell>
        <mxCell id="s4_e" value="" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;strokeColor=#545B64;fontSize=11;fontColor=#545B64;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4_a" target="s4_b">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="s5_h" value="DNS" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#545B64;fontColor=#232F3E;" vertex="1" parent="strip">
          <mxGeometry x="2656" y="36" width="516" height="22" as="geometry" />
        </mxCell>
        <mxCell id="s5_a" value="&lt;b&gt;Today:&lt;/b&gt; A public and an internal zone, both delegated from a parent zone in the same account (system/r53/opsfleet)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;rounded=1;arcSize=6;fillColor=#F4F6F8;strokeColor=#AAB7B8;" vertex="1" parent="strip">
          <mxGeometry x="2656" y="62" width="516" height="66" as="geometry" />
        </mxCell>
        <mxCell id="s5_b" value="&lt;b&gt;Proposal:&lt;/b&gt; Parent zone innovate.example in Shared Services; subzones delegated to Dev, Staging and Prod; dns-writer for a change in the parent zone." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#CD2264;" vertex="1" parent="strip">
          <mxGeometry x="2656" y="152" width="516" height="76" as="geometry" />
        </mxCell>
        <mxCell id="s5_e" value="" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;strokeColor=#545B64;fontSize=11;fontColor=#545B64;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s5_a" target="s5_b">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="s6_h" value="Accounts" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#545B64;fontColor=#232F3E;" vertex="1" parent="strip">
          <mxGeometry x="3184" y="36" width="516" height="22" as="geometry" />
        </mxCell>
        <mxCell id="s6_a" value="&lt;b&gt;Today:&lt;/b&gt; One standalone account, no AWS Organization." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;rounded=1;arcSize=6;fillColor=#F4F6F8;strokeColor=#AAB7B8;" vertex="1" parent="strip">
          <mxGeometry x="3184" y="62" width="516" height="66" as="geometry" />
        </mxCell>
        <mxCell id="s6_b" value="&lt;b&gt;Proposal:&lt;/b&gt; One account per environment (Dev, Staging, Prod) plus Management, Security Tooling, Log Archive, Shared Services and Backup." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#CD2264;" vertex="1" parent="strip">
