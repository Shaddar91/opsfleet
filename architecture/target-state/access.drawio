<mxfile host="app.diagrams.net">
  <diagram id="target-access" name="Proposal: access">
    <mxGraphModel dx="3800" dy="2700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3800" pageHeight="2700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Proposal: sign-in and role assumption in the AWS Organization" style="text;html=1;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="2600" height="42" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Target state. Nothing on this page exists yet." style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#545B64;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="2600" height="24" as="geometry" />
        </mxCell>
        <mxCell id="subtitle2" value="The four lanes of current-state/access, in the same order. Each lane starts outside AWS on the left and ends at the rights a principal gets; pink frames are accounts of the proposed organization (target-state/organization). Angle brackets mark a placeholder." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#687078;" vertex="1" parent="1">
          <mxGeometry x="40" y="76" width="3000" height="20" as="geometry" />
        </mxCell>
        <mxCell id="outside" value="Outside AWS" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#545B64;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="300" height="22" as="geometry" />
        </mxCell>
        <mxCell id="org" value="AWS Organization: Innovate Inc." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#232F3E;strokeWidth=2;fontColor=#232F3E;fontSize=17;fontStyle=1;align=left;verticalAlign=top;spacingLeft=50;spacingTop=8;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1">
          <mxGeometry x="900" y="104" width="2860" height="1834" as="geometry" />
        </mxCell>
        <mxCell id="org_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.organizations;" vertex="1" parent="org">
          <mxGeometry x="12" y="6" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="l1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFBFB;strokeColor=#D5DBDB;" vertex="1" parent="org">
          <mxGeometry x="20" y="44" width="2820" height="564" as="geometry" />
        </mxCell>
        <mxCell id="l1_t" value="1 Developer: Google Workspace sign-in with MFA, IAM Identity Center, a role in Dev, and the cross-account hop to Route 53" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#DD344C;" vertex="1" parent="org">
          <mxGeometry x="32" y="50" width="2700" height="28" as="geometry" />
        </mxCell>
        <mxCell id="l2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFBFB;strokeColor=#D5DBDB;" vertex="1" parent="org">
          <mxGeometry x="20" y="624" width="2820" height="292" as="geometry" />
        </mxCell>
        <mxCell id="l2_t" value="2 Operator: the same sign-in with PlatformAdmin; Staging and Prod change only through the pipeline" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#147EBA;" vertex="1" parent="org">
          <mxGeometry x="32" y="630" width="2700" height="28" as="geometry" />
        </mxCell>
        <mxCell id="l3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFBFB;strokeColor=#D5DBDB;" vertex="1" parent="org">
          <mxGeometry x="20" y="932" width="2820" height="574" as="geometry" />
        </mxCell>
        <mxCell id="l3_t" value="3 CI: GitHub Actions, OIDC token, sts:AssumeRoleWithWebIdentity, one role per account" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#ED7100;" vertex="1" parent="org">
          <mxGeometry x="32" y="938" width="2700" height="28" as="geometry" />
        </mxCell>
        <mxCell id="l4" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFBFB;strokeColor=#D5DBDB;" vertex="1" parent="org">
          <mxGeometry x="20" y="1522" width="2820" height="296" as="geometry" />
        </mxCell>
        <mxCell id="l4_t" value="4 In cluster: Argo CD and pods in each workload account; image pulls and Grafana reads across accounts" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#8C4FFF;" vertex="1" parent="org">
          <mxGeometry x="32" y="1528" width="2700" height="28" as="geometry" />
        </mxCell>
        <mxCell id="d0" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Developer laptop&lt;/font&gt;&lt;/b&gt;&lt;br&gt;AWS CLI v2 and kubectl. One profile per account and permission set, set up once with aws configure sso. No long-lived access key: no IAM user exists." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;spacingLeft=6;spacingTop=62;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="232" width="256" height="170" as="geometry" />
        </mxCell>
        <mxCell id="d0_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.client;dashed=0;" vertex="1" parent="d0">
          <mxGeometry x="103" y="8" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Google Workspace sign-in with MFA&lt;/font&gt;&lt;/b&gt;&lt;br&gt;The identity provider: users and groups live here. MFA is enforced once, here, for every sign-in to AWS; with an external IdP, IAM Identity Center leaves MFA to the IdP." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;spacingLeft=6;spacingTop=62;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="330" y="232" width="256" height="196" as="geometry" />
        </mxCell>
        <mxCell id="d1_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.mfa_token;dashed=0;" vertex="1" parent="d1">
          <mxGeometry x="103" y="8" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;SAML and SCIM&lt;/font&gt;&lt;/b&gt;&lt;br&gt;SAML federation signs the user in to IAM Identity Center. SCIM provisions users and groups from Google Workspace, so access follows group membership (F14)." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;spacingLeft=6;spacingTop=62;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="620" y="232" width="256" height="196" as="geometry" />
        </mxCell>
        <mxCell id="d2_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.users;dashed=0;" vertex="1" parent="d2">
          <mxGeometry x="103" y="8" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="f1m" value="&lt;b&gt;Management account&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#687078&quot;&gt;innovate-management&lt;/font&gt;" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;strokeColor=#CD2264;fillColor=#FFFFFF;verticalAlign=top;align=left;spacingLeft=30;fontColor=#CD2264;dashed=0;" vertex="1" parent="org">
          <mxGeometry x="40" y="84" width="296" height="256" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;IAM Identity Center&lt;/font&gt;&lt;/b&gt;&lt;br&gt;The instance lives in the Management account. Administration (users, groups, assignments) is delegated to Security Tooling, so nobody works in Management. An assignment joins a group, a permission set and an account (F13)." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;spacingLeft=6;spacingTop=62;align=center;fontSize=11;" vertex="1" parent="f1m">
          <mxGeometry x="20" y="44" width="256" height="196" as="geometry" />
        </mxCell>
        <mxCell id="d3_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.single_sign_on;" vertex="1" parent="d3">
          <mxGeometry x="103" y="8" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Sign in from the CLI&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;spacingLeft=6;spacingTop=6;align=center;fontSize=11;" vertex="1" parent="org">
          <mxGeometry x="370" y="128" width="256" height="196" as="geometry" />
        </mxCell>
        <mxCell id="d4_c" value="aws sso login&lt;br&gt;&amp;nbsp;--profile &amp;lt;account&amp;gt;-&amp;lt;permission-set&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=10;fontColor=#232F3E;spacingLeft=5;spacingTop=1;fillColor=#F4F6F8;strokeColor=#D5DBDB;" vertex="1" parent="d4">
          <mxGeometry x="8" y="32" width="240" height="34" as="geometry" />
        </mxCell>
        <mxCell id="d4_t" value="Opens the browser sign-in of steps 1 to 3 and caches the session. Here the profile names Dev and the Developer permission set." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;verticalAlign=top;align=center;" vertex="1" parent="d4">
          <mxGeometry x="6" y="72" width="244" height="90" as="geometry" />
        </mxCell>
        <mxCell id="d5" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;AWS STS: short-lived credentials&lt;/font&gt;&lt;/b&gt;&lt;br&gt;IAM Identity Center hands the CLI credentials for the role of that permission set in that account, valid for the permission set&#x27;s session duration. No second MFA prompt: MFA happened at sign-in." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;spacingLeft=6;spacingTop=62;align=center;fontSize=11;" vertex="1" parent="org">
          <mxGeometry x="660" y="128" width="256" height="196" as="geometry" />
        </mxCell>
        <mxCell id="d5_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.temporary_security_credential;dashed=0;" vertex="1" parent="d5">
          <mxGeometry x="103" y="8" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="f1d" value="&lt;b&gt;Dev&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#687078&quot;&gt;innovate-dev&lt;/font&gt;" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;strokeColor=#CD2264;fillColor=#FFFFFF;verticalAlign=top;align=left;spacingLeft=30;fontColor=#CD2264;dashed=0;" vertex="1" parent="org">
          <mxGeometry x="940" y="84" width="1166" height="256" as="geometry" />
        </mxCell>
        <mxCell id="d6" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;AWSReservedSSO_Developer_&amp;lt;hash&amp;gt;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Role in Dev, created and owned by IAM Identity Center from the Developer permission set (F13). Rights: deploy, kubectl write through EKS access entries, logs; no IAM write." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;spacingLeft=6;spacingTop=62;align=center;fontSize=11;" vertex="1" parent="f1d">
          <mxGeometry x="20" y="44" width="256" height="196" as="geometry" />
        </mxCell>
        <mxCell id="d6_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.role;dashed=0;" vertex="1" parent="d6">
          <mxGeometry x="103" y="8" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d7" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Point kubectl at the Dev cluster&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;spacingLeft=6;spacingTop=6;align=center;fontSize=11;" vertex="1" parent="f1d">
          <mxGeometry x="310" y="44" width="256" height="196" as="geometry" />
        </mxCell>
        <mxCell id="d7_c" value="aws eks update-kubeconfig&lt;br&gt;&amp;nbsp;--name &amp;lt;cluster&amp;gt;&lt;br&gt;&amp;nbsp;--profile &amp;lt;account&amp;gt;-&amp;lt;permission-set&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=10;fontColor=#232F3E;spacingLeft=5;spacingTop=1;fillColor=#F4F6F8;strokeColor=#D5DBDB;" vertex="1" parent="d7">
          <mxGeometry x="8" y="32" width="240" height="46" as="geometry" />
        </mxCell>
        <mxCell id="d7_t" value="Writes the kubeconfig once. Each kubectl call then runs aws eks get-token under the same profile." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;verticalAlign=top;align=center;" vertex="1" parent="d7">
          <mxGeometry x="6" y="84" width="244" height="90" as="geometry" />
        </mxCell>
        <mxCell id="d8" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;EKS access entry&lt;/font&gt;&lt;/b&gt;&lt;br&gt;On the Dev cluster: maps the AWSReservedSSO_Developer role ARN to a Kubernetes group with write rights. In Staging and Prod the entry for people is read only." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;spacingLeft=6;spacingTop=62;align=center;fontSize=11;" vertex="1" parent="f1d">
          <mxGeometry x="600" y="44" width="256" height="196" as="geometry" />
        </mxCell>
        <mxCell id="d8_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eks;" vertex="1" parent="d8">
          <mxGeometry x="103" y="8" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d9" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Commands in Dev&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;spacingLeft=6;spacingTop=6;align=center;fontSize=11;" vertex="1" parent="f1d">
          <mxGeometry x="890" y="44" width="256" height="196" as="geometry" />
        </mxCell>
        <mxCell id="d9_c" value="aws &amp;lt;service&amp;gt; &amp;lt;command&amp;gt;&lt;br&gt;&amp;nbsp;--profile &amp;lt;account&amp;gt;-&amp;lt;permission-set&amp;gt;&lt;br&gt;kubectl get pods&lt;br&gt;kubectl apply -f &amp;lt;manifest&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=10;fontColor=#232F3E;spacingLeft=5;spacingTop=1;fillColor=#F4F6F8;strokeColor=#D5DBDB;" vertex="1" parent="d9">
          <mxGeometry x="8" y="32" width="240" height="58" as="geometry" />
        </mxCell>
        <mxCell id="d9_t" value="Write rights in Dev only. The permission set decides what a session can do, in the console and on the CLI alike." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;verticalAlign=top;align=center;" vertex="1" parent="d9">
          <mxGeometry x="6" y="96" width="244" height="90" as="geometry" />
        </mxCell>
        <mxCell id="psets" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Permission sets in IAM Identity Center&lt;/font&gt;&lt;/b&gt;&lt;br&gt;OrgAdmin: Management; two named people, used rarely.&lt;br&gt;PlatformAdmin: Shared Services, Security Tooling, Dev.&lt;br&gt;Developer: Dev.&lt;br&gt;SecurityAnalyst: Security Tooling; Log Archive read only.&lt;br&gt;ReadOnly: every account.&lt;br&gt;BreakGlass: Staging, Prod, Backup; an empty group by default.&lt;br&gt;&lt;br&gt;Each becomes a role AWSReservedSSO_&amp;lt;permission-set&amp;gt;_&amp;lt;hash&amp;gt; in every account it is assigned to." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;align=left;spacingLeft=50;spacingTop=3;fontSize=12;" vertex="1" parent="org">
          <mxGeometry x="2140" y="128" width="680" height="196" as="geometry" />
        </mxCell>
        <mxCell id="psets_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.permissions;dashed=0;" vertex="1" parent="psets">
          <mxGeometry x="8" y="8" width="34" height="34" as="geometry" />
        </mxCell>
        <mxCell id="b1_0" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#DD344C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="org">
          <mxGeometry x="-564" y="134" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="b1_1" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#DD344C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="org">
          <mxGeometry x="-274" y="134" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="b1_2" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#DD344C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="org">
          <mxGeometry x="66" y="134" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="b1_3" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#DD344C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="org">
          <mxGeometry x="376" y="134" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="b1_4" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#DD344C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="org">
          <mxGeometry x="666" y="134" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="b1_5" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#DD344C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="org">
          <mxGeometry x="966" y="134" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="b1_6" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#DD344C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="org">
          <mxGeometry x="1256" y="134" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="b1_7" value="8" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#DD344C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="org">
          <mxGeometry x="1546" y="134" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="b1_8" value="9" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#DD344C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="org">
          <mxGeometry x="1836" y="134" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="e1_0" value="" style="html=1;rounded=0;endArrow=block;endFill=1;endSize=6;strokeWidth=2.5;strokeColor=#DD344C;fontSize=11;fontColor=#545B64;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.1941;exitDx=0;exitDy=0;entryX=0.0;entryY=0.1684;entryDx=0;entryDy=0;" edge="1" parent="1" source="d0" target="d1">
