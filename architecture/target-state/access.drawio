        <mxCell id="o6_c" value="aws &amp;lt;service&amp;gt; &amp;lt;command&amp;gt;&lt;br&gt;&amp;nbsp;--profile &amp;lt;account&amp;gt;-PlatformAdmin" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=10;fontColor=#232F3E;spacingLeft=5;spacingTop=1;fillColor=#F4F6F8;strokeColor=#D5DBDB;" vertex="1" parent="o6">
          <mxGeometry x="8" y="32" width="240" height="34" as="geometry" />
        </mxCell>
        <mxCell id="o6_t" value="Administrative rights in Shared Services, Security Tooling and Dev only." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;verticalAlign=top;align=center;" vertex="1" parent="o6">
          <mxGeometry x="6" y="72" width="244" height="60" as="geometry" />
        </mxCell>
        <mxCell id="o7" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Staging and Prod: through the pipeline&lt;/font&gt;&lt;/b&gt;&lt;br&gt;No permission set for daily work grants a person write access there. A change is a commit and a pipeline run: terraform plan on the pull request, apply on merge, with gha-deploy (lane 3)." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;spacingLeft=6;spacingTop=62;align=center;fontSize=11;" vertex="1" parent="org">
          <mxGeometry x="1560" y="708" width="256" height="176" as="geometry" />
        </mxCell>
        <mxCell id="o7_i" value="" style="shape=mxgraph.weblogos.github;html=1;fillColor=#24292E;strokeColor=none;" vertex="1" parent="o7">
          <mxGeometry x="103" y="8" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="root" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Root users&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Management: hardware MFA, no access keys, credentials in a physical safe, an alarm on every sign-in. Member accounts: root credentials removed with Organizations centralized root access management; the rare root-only actions run as privileged sessions from Management." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;align=left;spacingLeft=8;spacingTop=3;fontSize=11;" vertex="1" parent="org">
          <mxGeometry x="1860" y="664" width="960" height="104" as="geometry" />
        </mxCell>
        <mxCell id="boot" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Bootstrap, once&lt;/font&gt;&lt;/b&gt;&lt;br&gt;The org/ stack is applied once with local state from an administrator workstation; then its state moves to the Shared Services state bucket and CI runs it through gha-org-admin (lane 3)." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;align=left;spacingLeft=8;spacingTop=3;fontSize=11;" vertex="1" parent="org">
          <mxGeometry x="1860" y="780" width="960" height="120" as="geometry" />
        </mxCell>
