        </mxCell>
        <mxCell id="d10_t" value="The caller is the Dev role session of step 6; STS returns short-lived credentials of dns-writer." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;verticalAlign=top;align=center;" vertex="1" parent="d10">
