        <mxCell id="ro" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Staging and Prod: people get ReadOnly&lt;/font&gt;&lt;/b&gt;&lt;br&gt;AWSReservedSSO_ReadOnly_&amp;lt;hash&amp;gt; in each account: ViewOnlyAccess, CloudWatch Logs read, read-only kubectl through an EKS access entry. No permission set for daily work grants write there." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;align=left;spacingLeft=50;spacingTop=3;fontSize=11;" vertex="1" parent="org">
          <mxGeometry x="40" y="406" width="880" height="74" as="geometry" />
        </mxCell>
        <mxCell id="ro_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.role;dashed=0;" vertex="1" parent="ro">
          <mxGeometry x="8" y="8" width="34" height="34" as="geometry" />
        </mxCell>
        <mxCell id="bg" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;BreakGlass: time-boxed and paged&lt;/font&gt;&lt;/b&gt;&lt;br&gt;AWSReservedSSO_BreakGlass_&amp;lt;hash&amp;gt; in Staging, Prod and Backup: AdministratorAccess, an empty group by default. A named approver adds a person for a time-boxed window; every assumption is paged through Security Tooling (F5) and followed by a post-incident review." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;align=left;spacingLeft=50;spacingTop=3;fontSize=11;" vertex="1" parent="org">
          <mxGeometry x="40" y="492" width="880" height="84" as="geometry" />
        </mxCell>
