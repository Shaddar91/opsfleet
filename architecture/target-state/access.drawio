          <mxGeometry x="8" y="8" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="act_1" value="terraform plan on the pull request and terraform apply on merge, in its own account, with state in its own prefix of the Shared Services state bucket (F9). The same pipelines update the environment&#x27;s manifests or Helm values in the GitOps repository (F7)." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;align=left;spacingLeft=8;spacingTop=3;fontSize=11;" vertex="1" parent="org">
          <mxGeometry x="900" y="1064" width="1100" height="86" as="geometry" />
        </mxCell>
        <mxCell id="gate_1" value="The GitHub environment named after the account: the trust admits only a job running in it. Staging and Prod have no other write path." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;align=left;spacingLeft=8;spacingTop=3;fontSize=11;" vertex="1" parent="org">
