        <mxCell id="rf_1" value="&lt;b&gt;Dev, Staging, Prod&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size:11px&quot; color=&quot;#687078&quot;&gt;one gha-deploy per account&lt;/font&gt;" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;strokeColor=#CD2264;fillColor=#FFFFFF;verticalAlign=top;align=left;spacingLeft=30;fontColor=#CD2264;dashed=0;" vertex="1" parent="org">
          <mxGeometry x="140" y="1064" width="720" height="86" as="geometry" />
        </mxCell>
        <mxCell id="role_1" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;gha-deploy&lt;/font&gt;&lt;/b&gt;: trust repo:innovate-inc/&amp;lt;repository&amp;gt;:environment:&amp;lt;account&amp;gt;. Carries a permissions boundary set by the account baseline." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;align=left;spacingLeft=40;spacingTop=3;fontSize=11;" vertex="1" parent="rf_1">
