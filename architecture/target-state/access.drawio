        <mxCell id="hopnote" value="&lt;b&gt;Pipelines keep the default:&lt;/b&gt; dev., staging. and prod. subzones are delegated by NS records to the workload accounts, so day-to-day records never cross accounts.&lt;br&gt;&lt;br&gt;dns-writer is for a change in the parent zone itself, such as the apex or app.innovate.example." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;spacingLeft=12;spacingRight=12;spacingTop=8;strokeColor=#CD2264;fillColor=#FDF2F7;rounded=1;arcSize=4;" vertex="1" parent="org">
          <mxGeometry x="2390" y="406" width="430" height="170" as="geometry" />
        </mxCell>
        <mxCell id="o0" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Platform engineer workstation&lt;/font&gt;&lt;/b&gt;&lt;br&gt;AWS CLI v2 and kubectl, with profiles from aws configure sso. No source profile and no access key." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;spacingLeft=6;spacingTop=62;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="812" width="256" height="170" as="geometry" />
        </mxCell>
        <mxCell id="o0_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.client;dashed=0;" vertex="1" parent="o0">
          <mxGeometry x="103" y="8" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="o1" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Same sign-in as lane 1&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Google Workspace with MFA, then SAML into IAM Identity Center. The platform engineers are a Google Workspace group, provisioned by SCIM." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;spacingLeft=6;spacingTop=62;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="330" y="812" width="546" height="176" as="geometry" />
        </mxCell>
        <mxCell id="o1_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.mfa_token;dashed=0;" vertex="1" parent="o1">
          <mxGeometry x="248" y="8" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="f2m" value="&lt;b&gt;Management account&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#687078&quot;&gt;innovate-management&lt;/font&gt;" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;strokeColor=#CD2264;fillColor=#FFFFFF;verticalAlign=top;align=left;spacingLeft=30;fontColor=#CD2264;dashed=0;" vertex="1" parent="org">
          <mxGeometry x="40" y="664" width="296" height="236" as="geometry" />
        </mxCell>
        <mxCell id="o2" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Assignment: PlatformAdmin&lt;/font&gt;&lt;/b&gt;&lt;br&gt;IAM Identity Center gives the platform engineers&#x27; group the PlatformAdmin permission set in Shared Services, Security Tooling and Dev. OrgAdmin in Management goes to two named people." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;spacingLeft=6;spacingTop=62;align=center;fontSize=11;" vertex="1" parent="f2m">
          <mxGeometry x="20" y="44" width="256" height="176" as="geometry" />
        </mxCell>
        <mxCell id="o2_i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.single_sign_on;" vertex="1" parent="o2">
          <mxGeometry x="103" y="8" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="o3" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Sign in from the CLI&lt;/font&gt;&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;spacingLeft=6;spacingTop=6;align=center;fontSize=11;" vertex="1" parent="org">
          <mxGeometry x="370" y="708" width="256" height="176" as="geometry" />
        </mxCell>
        <mxCell id="o3_c" value="aws sso login&lt;br&gt;&amp;nbsp;--profile &amp;lt;account&amp;gt;-PlatformAdmin" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=10;fontColor=#232F3E;spacingLeft=5;spacingTop=1;fillColor=#F4F6F8;strokeColor=#D5DBDB;" vertex="1" parent="o3">
          <mxGeometry x="8" y="32" width="240" height="34" as="geometry" />
        </mxCell>
        <mxCell id="o3_t" value="The same browser sign-in as lane 1, with a PlatformAdmin profile." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;verticalAlign=top;align=center;" vertex="1" parent="o3">
          <mxGeometry x="6" y="72" width="244" height="80" as="geometry" />
        </mxCell>
        <mxCell id="o4" value="&lt;b&gt;&lt;font style=&quot;font-size:12px&quot;&gt;AWS STS: short-lived credentials&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Credentials for the PlatformAdmin role in that account, valid for the permission set&#x27;s session duration." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;spacingLeft=6;spacingTop=62;align=center;fontSize=11;" vertex="1" parent="org">
          <mxGeometry x="660" y="708" width="256" height="176" as="geometry" />
