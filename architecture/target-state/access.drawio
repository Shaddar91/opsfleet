        <mxCell id="f2p" value="&lt;b&gt;Shared Services, Security Tooling, Dev&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#687078&quot;&gt;innovate-shared-services, innovate-security, innovate-dev&lt;/font&gt;" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_account;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;strokeColor=#CD2264;fillColor=#FFFFFF;verticalAlign=top;align=left;spacingLeft=30;fontColor=#CD2264;dashed=0;" vertex="1" parent="org">
          <mxGeometry x="940" y="664" width="586" height="236" as="geometry" />
        </mxCell>
        <mxCell id="o5" value="&lt;b&gt;&lt;font style=&quot;font-size:11px&quot;&gt;AWSReservedSSO_PlatformAdmin_&lt;br&gt;&amp;lt;hash&amp;gt;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;One role in each of the three accounts, created by IAM Identity Center (F13). Administrative access to platform tooling and Dev." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#232F3E;verticalAlign=top;spacingRight=6;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#879196;spacingLeft=6;spacingTop=62;align=center;fontSize=11;" vertex="1" parent="f2p">
          <mxGeometry x="20" y="44" width="256" height="176" as="geometry" />
        </mxCell>
