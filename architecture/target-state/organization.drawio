        <mxCell id="lg_g4_txt" value="Backup: F10 (the dashed part is the Staging copy, if required)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="legend">
