          <mxGeometry x="10" y="164" width="56" height="16" as="geometry" />
        </mxCell>
        <mxCell id="lg_badge_txt" value="One of the four shared accounts named below the legend." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="legend">
          <mxGeometry x="70" y="159" width="440" height="26" as="geometry" />
        </mxCell>
        <mxCell id="lg_multi_txt" value="A flow drawn as several arrows carries its full label once; its other arrows show only the number." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="legend">
          <mxGeometry x="16" y="192" width="494" height="40" as="geometry" />
        </mxCell>
        <mxCell id="lg_flows_title" value="&lt;b&gt;Flows across account boundaries, by group&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="legend">
