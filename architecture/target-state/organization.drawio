        <mxCell id="lg_g3_txt" value="Delivery: F6, F7, F8, F9" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="legend">
