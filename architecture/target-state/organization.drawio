        <mxCell id="lg_ou_txt" value="OU; an arrow that starts or ends on an OU frame stands for every account in that OU." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="legend">
