        </mxCell>
        <mxCell id="lg_g8_txt" value="Policy: F15 (hollow arrowhead: inherited down the tree)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="legend">
          <mxGeometry x="600" y="198" width="380" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg_g9_txt" value="Traffic: F16" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="legend">
          <mxGeometry x="600" y="218" width="380" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg_statements" value="No VPC-to-VPC connectivity exists between accounts (no peering, no Transit Gateway, no PrivateLink).&lt;br&gt;&lt;br&gt;No Kubernetes API access crosses an account boundary (ArgoCD runs inside each cluster).&lt;br&gt;&lt;br&gt;No path exists from Shared Services into Backup.&lt;br&gt;&lt;br&gt;Humans: ReadOnly everywhere, write only in Dev (Developer), Shared Services and Security Tooling (PlatformAdmin / SecurityAnalyst), Management (OrgAdmin); BreakGlass in Staging, Prod, Backup.&lt;br&gt;&lt;br&gt;Reserved for later, not on day one: a Data OU under Workloads for a data engineering account, and a Transit account under Infrastructure holding a Transit Gateway shared through RAM." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;spacingLeft=12;spacingRight=12;spacingTop=8;strokeColor=#CD2264;fillColor=#FDF2F7;rounded=1;arcSize=4;" vertex="1" parent="legend">
          <mxGeometry x="1000" y="36" width="704" height="240" as="geometry" />
        </mxCell>
