        <mxCell id="lg_dashed_txt" value="Dashed: optional or reserved for later; not created on day one." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="legend">
