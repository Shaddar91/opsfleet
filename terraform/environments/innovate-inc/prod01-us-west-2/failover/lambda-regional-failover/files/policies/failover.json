{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DescribeClusters",
      "Effect": "Allow",
      "Action": [
        "rds:DescribeGlobalClusters",
        "rds:DescribeDBClusters"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PromoteStandby",
      "Effect": "Allow",
      "Action": [
        "rds:FailoverGlobalCluster",
        "rds:SwitchoverGlobalCluster"
      ],
      "Resource": [
        "${GLOBAL_CLUSTER_ARN}",
        "${PRIMARY_CLUSTER_ARN}",
        "${STANDBY_CLUSTER_ARN}"
      ]
    },
    {
      "Sid": "MoveTraffic",
      "Effect": "Allow",
      "Action": [
        "globalaccelerator:DescribeEndpointGroup",
        "globalaccelerator:UpdateEndpointGroup"
      ],
      "Resource": [
        "${PRIMARY_ENDPOINT_GROUP_ARN}",
        "${STANDBY_ENDPOINT_GROUP_ARN}"
      ]
    },
    {
      "Sid": "ReadConfig",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "${SECRET_ARN}"
    }
  ]
}
