{
    "Version": "2012-10-17",
    "Statement": [{
        "Effect": "Allow",
        "Principal": {
            "Service": "logdelivery.elasticloadbalancing.amazonaws.com"
        },
        "Action": "s3:PutObject",
        "Resource": "arn:aws:s3:::${BUCKET}/%{ if PREFIX != "" }${PREFIX}/%{ endif }AWSLogs/${ACCOUNT_ID}/*"
    }]
}
